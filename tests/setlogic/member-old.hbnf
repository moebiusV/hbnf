; The old spelling of element of, refused since R647 (tests/setlogic.sh checks the message): `x ? S` is `x in S`, `x ?! S` is `x not in S`; the
; spelling changes nothing in the parser that is made.
prefix none
context types

program   = *statement
statement = typedef-decl | use
typedef-decl = "typedef" name %bind types += name ";"
use       = known ";" | fresh "!"
known     = name ? types
fresh     = name ?! types
name      = word
