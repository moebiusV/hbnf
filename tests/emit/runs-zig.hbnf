; tests/emit/runs.hbnf for the Zig backend: the choices are tried in order, and `rollback { depth }` puts the place back for an
; alternative that is given up, so only the one that succeeds leaves its pushes.
language Zig
prefix none
whitespace none
{
pub var stack: [64]i32 = undefined;
pub var depth: usize = 0;
fn push(v: i32) void {
    stack[depth] = v;
    depth += 1;
}
}
rollback { depth }

top   :: i32 = name "(" digit ")" %emit{ push(100); $$ = 1; } | name "(" ")" %emit{ push(200); $$ = 2; } | name ":" name %emit{ push(300); $$ = 3; } | name %emit{ push(400); $$ = 4; }
name  :: i32 = "a" %emit{ push(1); } | "b" %emit{ push(1); } | "c" %emit{ push(1); }
digit :: i32 = "0" %emit{ push(2); } | "1" %emit{ push(2); }
