; %action { } for the Zig backend: the code is Zig, over the node `n` once its children are done (children first, as C's walk is);
; `h.line` is the line the node began on and `h.bind_error("fmt", .{ args })` reports a mistake without stopping the walk: the read
; fails when it ends, with the first one
language Zig
prefix none
whitespace none
{
pub var seen: u32 = 0;
}
config = *( entry )
entry  = "set" " " word ";\n" %action{ seen += 1; if (n.word.len > 3) h.bind_error("`{s}` is too long", .{n.word}); }
word   = 1*0x61..0x7a
