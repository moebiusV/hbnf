; tests/emit/safe.hbnf for the Zig backend: every emit is where nothing can retry past it.  A rule of characters (`key`) is read as text
; and is a variable of the emit that names it; a rule that holds emits is a value, here a u8 when it declares none.
language Zig
prefix none
whitespace none
{
pub var trace: [200]u8 = undefined;
pub var trace_len: usize = 0;
fn note(s: []const u8) void {
    @memcpy(trace[trace_len .. trace_len + s.len], s);
    trace_len += s.len;
}
fn open() u32 {
    note("{");
    return @intCast(trace_len);
}
}
top :: u32 = "{" %emit{ $$ = open(); } [ pair *( "," pair ) ] "}" %emit{ note("}"); }
pair :: u32 = key ":" val %emit{ note("p:"); note(key); }
key = 0x61..0x7A
val = "t" %emit{ note("y"); } | "f" %emit{ note("n"); } | top
