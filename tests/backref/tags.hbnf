; A back-reference (RFCPLAN.md, W-grammars): `$tag` is the text `name as tag` kept.
; A tag closes with the name it opened with, however deep, however often it
; repeats; `<a><b></a></b>` is not a document.
prefix none
include "../../grammars/common.hbnf"
whitespace none

doc      = *node
node     = element / text
element  = "<" name as tag ">" *node "</" $tag ">"
name     = ALPHA *( ALPHA / DIGIT )
text     = 1*~"<"
