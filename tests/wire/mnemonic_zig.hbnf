language Zig
{
    // BIP-39's checksum: the first n/4 bits of the SHA-256 of n octets of entropy,
    // from Zig's standard library.
    fn bip39_checksum(entropy: []const u8) u64 {
        var h: [32]u8 = undefined;
        std.crypto.hash.sha2.Sha256.hash(entropy, &h, .{});
        return @as(u64, h[0] >> @intCast(8 - entropy.len / 4));
    }
}

; A BIP-39 mnemonic: words of the English list, 11 bits each, joined by blanks.
; The words are the entropy, then a checksum of one bit per 32 bits of it.
; `phrase` is read as text; `bitsof` makes its numbered words the bits that the
; rest of `mnemonic` reads (and, writing, spells the bits back as the words).
prefix none
whitespace none
include "../../grammars/bip39/english.hbnf"

doc = mnemonic
phrase = bip39-word *( bip39-space bip39-word )

; BIP-39 allows 12, 15, 18, 21 and 24 words.  Wallets mostly make 12 and 24,
; and not all can import the others, so those read with a warning.
mnemonic = words:bitsof(phrase)
           ?(remaining % 33 == 0 && remaining / 33 >= 4 && remaining / 33 <= 8)
              "a mnemonic has 12, 15, 18, 21 or 24 words"
           entropy:[remaining / 33 * 4]
           ?(len(entropy) % 4 == 0)
           checksum:bits(len(entropy) / 4)
  %action{
      // the checksum is the first bits of the SHA-256 of the entropy
      if (bip39_checksum(n.entropy) != n.checksum)
          return h.fail("the checksum does not match the words");
      // the entropy is 16 octets for 12 words, 32 for 24
      if (n.entropy.len != 16 and n.entropy.len != 32)
          h.warn("valid BIP-39, but wallets mostly make 12 and 24 words, and some cannot import any other length");
  }
  %emit{
      // writing a mnemonic from its entropy: the checksum is worked out
      n.checksum = bip39_checksum(n.entropy);
  }
