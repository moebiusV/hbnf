; A recursive tree type: every expression language needs this.  C, Ada and
; Rust break the cycle with a pointer (RFCPLAN.md step 9b); Zig still refuses
; it with "a rule's value cannot contain itself".  Rust used to emit code
; rustc rejected (E0072) and Zig code that failed the moment a size was
; forced (step 9a).
;
; tests/abnf.sh and tests/recursive.sh compile and run it.
language C
include "../../grammars/obconf.hbnf"

prim = '(' expr ')' | int
expr = prim
