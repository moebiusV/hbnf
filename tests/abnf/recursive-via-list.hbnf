; The same cycle laundered through a list.  The by-value cycle check does
; not see it (a list node embeds its element by value), so the generator
; accepts this and emits C that does not compile:
;   field 'sum' has incomplete type
;
; RFCPLAN.md step 9a.  Kept as a fixture; do not "fix" by changing the
; grammar — the generator is what is wrong.
language C
include "../../grammars/obconf.hbnf"

sum  = sum '+' term | term
term = '(' sums ')' | int
sums = 1*sum
