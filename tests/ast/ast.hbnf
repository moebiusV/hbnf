; The AST and its walker (tests/ast.sh): alternatives that are recorded, a list,
; a nested list, and a walk that knows how it got to each node.
prefix none

config = *( entry )
entry  = "set" name value ";" %label assign
       | "run" name ";" %label execute
       | block
block  = "{" *( entry ) "}"
value  = int | str | name
name   = word
