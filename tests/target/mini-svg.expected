<text class="dg" x="170" y="71">1</text>
<text class="dg" x="206" y="71">0</text>
<text class="dg" x="242" y="71">1</text>
<text class="dg" x="278" y="71">1</text>
<text class="dg" x="314" y="71">0</text>
<text class="dg" x="350" y="71">0</text>
<text class="dg" x="386" y="71">1</text>
<text class="dg" x="422" y="71">0</text>
<text class="dg" x="458" y="71">0</text>
</g>
