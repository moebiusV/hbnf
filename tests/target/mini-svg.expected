%%% index.html
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Bit layouts: examples/mini.hbnf</title>
<style>
:root{--bg:#fff;--ink:#1d2430;--dim:#5b6573}
@media (prefers-color-scheme:dark){:root{--bg:#161a20;--ink:#e6e9ee;--dim:#a2abb8}}
body{background:var(--bg);color:var(--ink);font-family:system-ui,sans-serif;margin:0 auto;max-width:56rem;padding:1rem 16px}
li{margin:.25rem 0}
.n{color:var(--dim);font-size:.85em}
</style>
</head>
<body>
<h1>Bit layouts: examples/mini.hbnf</h1>
<p>5 charts, 16 bits to a parcel.</p>
<ul>
<li><a href="leaf-NOP.svg">SYS0: no operand</a> <span class="n">16 bits, 1 parcel rows</span></li>
<li><a href="leaf-ADD3.svg">R3: three registers</a> <span class="n">24 bits, 2 parcel rows</span></li>
<li><a href="leaf-LDB28.svg">LDU.B28: load with a 28-bit displacement</a> <span class="n">48 bits, 3 parcel rows</span></li>
<li><a href="leaf-BRF.svg">BRF: far branch</a> <span class="n">48 bits, 3 parcel rows</span></li>
<li><a href="leaf-PUSHI.svg">PUSHI: trailing literals</a> <span class="n">variable length, 2 parcel rows</span></li>
</ul>
</body>
