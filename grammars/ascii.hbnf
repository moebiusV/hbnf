; ascii.hbnf — the non-printable ASCII characters, named.
;
; The C0 control characters (NUL .. US), DEL, and the blanks SP and HT/HTAB.
; Everything printable — and every character class — lives in common.hbnf,
; which includes this file.

; --- C0 control characters (0x00 .. 0x1F) ---
NUL = %x00
SOH = %x01
STX = %x02
ETX = %x03
EOT = %x04
ENQ = %x05
ACK = %x06
BEL = %x07
BS  = %x08
HT  = %x09
LF  = %x0A
VT  = %x0B
FF  = %x0C
CR  = %x0D
SO  = %x0E
SI  = %x0F
DLE = %x10
DC1 = %x11
DC2 = %x12
DC3 = %x13
DC4 = %x14
NAK = %x15
SYN = %x16
ETB = %x17
CAN = %x18
EM  = %x19
SUB = %x1A
ESC = %x1B
FS  = %x1C
GS  = %x1D
RS  = %x1E
US  = %x1F

; --- blanks and DEL ---
SP   = %x20
HTAB = %x09
DEL  = %x7F
