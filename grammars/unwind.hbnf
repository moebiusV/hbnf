; unwind.conf — OpenBSD unwind(8) configuration, as an hbnf grammar.
; Translated from sbin/unwind/parse.y.
;
;   %token keyword table   ->  "keyword" literals
;   STRING / NUMBER        ->  string (str/word) / int
;   { ... } tree actions   ->  implicit — the binder builds the tree
;   the DOT keyword — "dot"/"DoT"/"tls" are one token in parse.y's lookup()
;                     table                          ->  the dot inline jet below
;   the forwarder IP — a bareword that may be an IPv6 literal (with ':'),
;                      which the generated `word` can't swallow
;                                                    ->  the ipv6 inline jet below
;
; parse.y's `_l` list rules and its `'{' optnl X '}' | X` blocks are kept as
; top-level lists (`prefopts = 1*( prefopt )`) and explicit two-way
; alternations (`"{" prefopts "}" / prefopts`) — the same shape parse.y spells
; out, minus the newline scaffolding (the generated lexer skips newlines).

language C
wordchars "*/$@%"

{
#include <sys/queue.h>
#define HBNF_LIST_HEAD(name,type)  TAILQ_HEAD(name,type)
#define HBNF_LIST_ENTRY(type)      TAILQ_ENTRY(type) _link
#define HBNF_LIST_INIT(h)          TAILQ_INIT(h)
#define HBNF_LIST_APPEND(h,e)      TAILQ_INSERT_TAIL(h,e,_link)
#define HBNF_LIST_FOREACH(v,h)     TAILQ_FOREACH(v,h,_link)
#define HBNF_LIST_NEXT(e)          TAILQ_NEXT(e,_link)
#define HBNF_LIST_FIRST(h)         TAILQ_FIRST(h)
#define HBNF_LIST_RELINK(h)        do { if (TAILQ_EMPTY(h)) TAILQ_INIT(h); else TAILQ_FIRST(h)->_link.tqe_prev = &TAILQ_FIRST(h); } while (0)
}
include "commonconf.hbnf"



config     = *( include / varset / preference / forwarder / block_list / force )

include    = "include" string

; one or more STRING tokens (parse.y's `string : string STRING | STRING`)
stringlist = 1*string

varset     = string "=" stringlist                ; macro name = value…

preference = "preference" "{" prefopts "}"
           / "preference" prefopt
prefopts   = 1*prefopt

prefopt    = dot
           / prefopt_kw
prefopt_kw = "forwarder" / "oDoT-forwarder" / "recursor" / "autoconf"
           / "dhcp" / "oDoT-autoconf" / "oDoT-dhcp" / "stub"

forwarder  = "forwarder" "{" forwarderopts "}"
           / "forwarder" forwarderopt
forwarderopts = 1*forwarderopt

forwarderopt = address "port" int "authentication" "name" string dot
             / address "port" int "authentication" "name" string
             / address "port" int dot
             / address "port" int
             / address "authentication" "name" string dot
             / address "authentication" "name" string
             / address dot
             / address

block_list = "block" "list" string "log"
           / "block" "list" string

force      = "force" "accept" "bogus" prefopt "{" forcelist "}"
           / "force" prefopt "{" forcelist "}"
forcelist  = *string

; the forwarder IP: a STRING, or an IPv6 literal the bare `word` can't reach
address    = str / word / ipv6

; dot — the DOT keyword: parse.y's lookup() folds the three spellings into one
; token (a keyword-only enum would emit colliding C enumerators DOT_DOT).
;   dot = "dot" / "DoT" / "tls"
dot        = {
    const char *kw[] = { "dot", "DoT", "tls" };
    size_t i, n;
    for (i = 0; i < 3; i++) {
        n = strlen(kw[i]);
        if (pos + n > len || memcmp(s + pos, kw[i], n) != 0) continue;
        if (pos + n < len) {
            char c = s[pos + n];
            if (isalnum((unsigned char)c) || c == '_' || c == '-' || c == '.')
                continue;
        }
        return n;
    }
    return 0;
}

; ipv6 — hex groups separated by ":", with "::" allowed (syntax only; the
; daemon still runs host_ip for full validation).
;   ipv6 = 1*( hexdig / ":" ) with at least one hexdig and one ":"
ipv6       = {
    size_t n = 0, hex = 0, colon = 0;
    while (pos + n < len) {
        char c = s[pos + n];
        if ((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')) { hex = 1; n++; }
        else if (c == ':') { colon = 1; n++; }
        else break;
    }
    return (hex && colon) ? n : 0;
}
