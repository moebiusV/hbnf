; ntpd.conf — OpenBSD ntpd(8) configuration, as an hbnf grammar.
; Translated from usr.sbin/ntpd/parse.y.
;
;   %token keyword table   ->  "keyword" literals
;   STRING / NUMBER        ->  string (str/word) / int
;   { ... } tree actions   ->  implicit — the binder builds the tree
;   the lexer's address bareword (an IP or hostname, with `*` and `:` allowed,
;                          ->  resolved later by host()) -> the wildcard and
;                          ->  ipv6 inline jets below
;
; parse.y's `_l` list rules and its `{ opts_default(); } _opts_l | { }`
; option blocks are kept as top-level lists (`serveropts = *( serveropt )`)
; and explicit two-way alternations (`with rtable / without`) — the same
; shape parse.y spells out, minus the newline scaffolding (the generated
; lexer skips newlines).

language C

{
#include <sys/queue.h>
#define HBNF_LIST_HEAD(name,type)  TAILQ_HEAD(name,type)
#define HBNF_LIST_ENTRY(type)      TAILQ_ENTRY(type) _link
#define HBNF_LIST_INIT(h)          TAILQ_INIT(h)
#define HBNF_LIST_APPEND(h,e)      TAILQ_INSERT_TAIL(h,e,_link)
#define HBNF_LIST_FOREACH(v,h)     TAILQ_FOREACH(v,h,_link)
#define HBNF_LIST_NEXT(e)          TAILQ_NEXT(e,_link)
#define HBNF_LIST_FIRST(h)         TAILQ_FIRST(h)
}


config     = *( entry )

entry      = "listen" "on" address rtable
           / "listen" "on" address
           / "query" "from" string
           / "servers" address serveropts
           / "server" address serveropts
           / "constraints" "from" string
           / "constraint" "from" stringlist
           / "sensor" string sensoropts

; a STRING token: quoted ("cpu0") or bareword (10.0.0.1, example.com)
string     = str / word

; one or more STRING tokens (parse.y's `urllist : urllist address | url`)
stringlist = 1*string

rtable     = "rtable" int
weight     = "weight" int
trusted    = "trusted"
correction = "correction" int
refid      = "refid" string
stratum    = "stratum" int

; parse.y's server_opts_l / sensor_opts_l list rules
serveropts = *( serveropt )
serveropt  = weight / trusted

sensoropts = *( sensoropt )
sensoropt  = correction / refid / stratum / weight / trusted

; an address: a hostname, IPv4/IPv6 literal, or "*" — `string` plus the two
; forms the generated `word` token cannot match (":" and "*"), spelled out
; so the value stays a single string (a scalar union, like ldpd's address)
address    = wildcard / ipv6 / str / word

; wildcard — "*" (parse.y's bareword start char; `listen on *` binds all)
wildcard   = {
    return (s[pos] == '*') ? 1 : 0;
}

; ipv6 — hex groups separated by ":", with "::" and an IPv4-mapped tail
; (".d.d.d.d") allowed (syntax only; parse.y resolves the address later)
ipv6       = {
    size_t n = 0, hex = 0, colon = 0;
    while (pos + n < len) {
        char c = s[pos + n];
        if ((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')) { hex = 1; n++; }
        else if (c == ':') { colon = 1; n++; }
        else if (c == '.') { n++; }
        else break;
    }
    return (hex && colon) ? n : 0;
}
