; ntpd.conf — OpenBSD ntpd(8) configuration, as an hbnf grammar.
; Translated from usr.sbin/ntpd/parse.y.
;
;   %token keyword table   ->  "keyword" literals
;   STRING / NUMBER        ->  string (str/word) / int
;   { ... } tree actions   ->  implicit — the binder builds the tree
;   the lexer's address bareword (an IP or hostname, with `*` and `:` allowed,
;                          ->  resolved later by host()) -> the wildcard and
;                          ->  ipv6 inline jets below
;
; parse.y's `_l` list rules and its `{ opts_default(); } _opts_l | { }`
; option blocks are kept as top-level lists (`serveropts = *( serveropt )`)
; and explicit two-way alternations (`with rtable / without`) — the same
; shape parse.y spells out, minus the newline scaffolding (the generated
; lexer skips newlines).

language C
wordchars "*/$@%"
listops {
  head { TAILQ_HEAD(@name@, @elem@) }
  entry { TAILQ_ENTRY(@elem@) _link }
  init { TAILQ_INIT(@h@); }
  append { TAILQ_INSERT_TAIL(@h@, @e@, _link); }
  foreach { TAILQ_FOREACH(@v@, @h@, _link) }
  first { TAILQ_FIRST(@h@) }
  next { TAILQ_NEXT(@e@, _link) }
  relink { if (TAILQ_EMPTY(@h@)) TAILQ_INIT(@h@); else TAILQ_FIRST(@h@)->_link.tqe_prev = &TAILQ_FIRST(@h@); }
}

{
#include <sys/queue.h>
}

include "commonconf.hbnf"



config     = *( entry )

entry      = "listen" "on" address rtable
           / "listen" "on" address
           / "query" "from" string
           / "servers" address serveropts
           / "server" address serveropts
           / "constraints" "from" string
           / "constraint" "from" stringlist
           / "sensor" string sensoropts

rtable     = "rtable" int
weight     = "weight" int
trusted    = "trusted"
correction = "correction" int
refid      = "refid" string
stratum    = "stratum" int

; parse.y's server_opts_l / sensor_opts_l list rules
serveropts = *( serveropt )
serveropt  = weight / trusted

sensoropts = *( sensoropt )
sensoropt  = correction / refid / stratum / weight / trusted
