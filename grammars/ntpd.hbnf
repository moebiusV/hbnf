; ntpd.conf — OpenBSD ntpd(8) configuration, as an hbnf grammar.
; Translated from usr.sbin/ntpd/parse.y.
;
;   %token keyword table   ->  "keyword" literals
;   STRING / NUMBER        ->  string (str/word) / int
;   { ... } tree actions   ->  implicit — the binder builds the tree
;   the lexer's address bareword (an IP or hostname, with `*` and `:` allowed,
;                          ->  resolved later by host()) -> the wildcard and
;                          ->  ipv6 inline jets below
;
; parse.y's `_l` list rules and its `{ opts_default(); } _opts_l | { }`
; option blocks are kept as top-level lists (`serveropts = *( serveropt )`)
; and explicit two-way alternations (`with rtable / without`) — the same
; shape parse.y spells out, minus the newline scaffolding (the generated
; lexer skips newlines).

language C
wordchars "*/$@%"
include "tailq.hbnf"

{
#include <sys/queue.h>
}

include "commonconf.hbnf"



config     = *( entry )

entry      = "listen" "on" address listenopts
           / "query" "from" string
           / "servers" address serveropts
           / "server" address serveropts
           / "constraints" "from" string
           / "constraint" "from" stringlist
           / "sensor" string sensoropts {
    struct ntp_addr *h, *next;
    switch (n->kind) {
    case ENTRY_LISTEN: {
        struct listen_addr *la;
        if (host(n->address, &h) == -1 || !h) break;
        for (; h; h = next) {
            next = h->next;
            la = calloc(1, sizeof *la);
            la->fd = -1;
            la->rtable = 0;
            { rtable_t *rt; TAILQ_FOREACH(rt, &n->listenopts, _link) la->rtable = (int)rt->rtable.int_; }
            memcpy(&la->sa, &h->ss, sizeof la->sa);
            TAILQ_INSERT_TAIL(&conf->listen_addrs, la, entry);
        }
        break;
    }
    case ENTRY_QUERY: {
        struct sockaddr_in sin4; struct sockaddr_in6 sin6;
        memset(&sin4, 0, sizeof sin4);
        sin4.sin_family = AF_INET; sin4.sin_len = sizeof sin4;
        memset(&sin6, 0, sizeof sin6);
        sin6.sin6_family = AF_INET6; sin6.sin6_len = sizeof sin6;
        if (inet_pton(AF_INET, n->string, &sin4.sin_addr) == 1)
            memcpy(&query_addr4, &sin4, sin4.sin_len);
        else if (inet_pton(AF_INET6, n->string, &sin6.sin6_addr) == 1)
            memcpy(&query_addr6, &sin6, sin6.sin6_len);
        break;
    }
    case ENTRY_SERVERS:
    case ENTRY_SERVER: {
        struct ntp_peer *p = new_peer();
        host(n->address, &p->addr);
        { serveropt_t *so; TAILQ_FOREACH(so, &n->serveropts, _link) {
            p->weight = so->weight.int_;
            p->trusted = so->trusted;
        } }
        p->query_addr4 = query_addr4;
        p->query_addr6 = query_addr6;
        TAILQ_INSERT_TAIL(&conf->ntp_peers, p, entry);
        break;
    }
    case ENTRY_SENSOR: {
        struct ntp_conf_sensor *s = new_sensor(n->string);
        { sensoropt_t *so; TAILQ_FOREACH(so, &n->sensoropts, _link) {
            s->weight = so->weight.int_;
            s->correction = so->correction.int_;
            s->refstr = so->refid.string;
            s->stratum = so->stratum.int_;
            s->trusted = so->trusted;
        } }
        TAILQ_INSERT_TAIL(&conf->ntp_conf_sensors, s, entry);
        break;
    }
    default: break;
    }
}

rtable     = "rtable" int
weight     = "weight" int
trusted    = "trusted"
correction = "correction" int
refid      = "refid" string
stratum    = "stratum" int

; parse.y's listen_opts_l / server_opts_l / sensor_opts_l list rules
listenopts = *( rtable )

serveropts = *( serveropt )
serveropt  = weight / trusted

sensoropts = *( sensoropt )
sensoropt  = correction / refid / stratum / weight / trusted
