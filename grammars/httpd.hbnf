; httpd.conf — OpenBSD httpd(8) configuration, as an hbnf grammar.
; Translated from usr.sbin/httpd/parse.y.
;
;   %token keyword table   ->  "keyword" literals
;   STRING / NUMBER        ->  string (str/word) / int
;   { ... } tree actions   ->  implicit — the binder builds the tree
;
; parse.y's `optcommanl`-separated flag runs and its `[ X ]` optionals are kept
; as top-level lists (`tlsopts = *( tlsopt )`) and explicit alternations
; (`prefix X / prefix`) — the same shape parse.y spells out, minus the comma
; and newline scaffolding (the generated lexer skips newlines).
;
; There are no jets: httpd's `port` is `PORT (NUMBER | STRING)` at the grammar
; level — getservice() only validates the token it is handed — so it becomes
; the `"port" (int / string)` alternation below, not a hand-written scanner.

language C
wordchars "*$@%"
{
#include <sys/queue.h>
}
list-head { TAILQ_HEAD(@name@, @elem@) }
list-entry { TAILQ_ENTRY(@elem@) _link }
list-init { TAILQ_INIT(@h@); }
list-append { TAILQ_INSERT_TAIL(@h@, @e@, _link); }
list-foreach { TAILQ_FOREACH(@v@, @h@, _link) }
list-first { TAILQ_FIRST(@h@) }
list-next { TAILQ_NEXT(@e@, _link) }
list-relink { if (TAILQ_EMPTY(@h@)) TAILQ_INIT(@h@); else TAILQ_FIRST(@h@)->_link.tqe_prev = &TAILQ_FIRST(@h@); }

include "commonconf.hbnf"



config        = *( entry )

entry         = "prefork" int
              / "chroot" string
              / "errdocs" string
              / "logdir" string
              / "no" "banner"
              / "default" "type" mediastring
              / server
              / types
              / include
              / varset

include       = "include" string

varset        = vname "=" vvalue                ; macro name = value…

server        = "server" "match" string "{" serveropts "}"
              / "server" string "{" serveropts "}"
serveropts    = *( serveropt )

; the things that can live inside a `server { }` block
serveropt     = "listen" "on" string "tls" port
              / "listen" "on" string port
              / "alias" "match" string
              / "alias" string
              / "errdocs" string
              / "no" "errdocs"
              / tcpip
              / connection
              / tls
              / request
              / root
              / directory
              / "banner"
              / "no" "banner"
              / header
              / "static-cache-control"
              / "no" "static-cache-control"
              / logformat
              / fastcgi
              / authenticate
              / "gzip-static"
              / "no" "gzip-static"
              / filter
              / location
              / "default" "type" mediastring
              / include
              / hsts

; a port number or service name (parse.y `port : PORT NUMBER | PORT STRING`)
port          = "port" int
              / "port" string

; a location: `location [found] [match] STRING { ... }`
location      = "location" "found" "match" string "{" serveropts "}"
              / "location" "found" string "{" serveropts "}"
              / "location" "not" "found" "match" string "{" serveropts "}"
              / "location" "not" "found" string "{" serveropts "}"
              / "location" "match" string "{" serveropts "}"
              / "location" string "{" serveropts "}"

vname         = string                          ; macro name
vvalue        = string                          ; macro value
hname         = string                          ; header name
hvalue        = string                          ; header value
pname         = string                          ; fastcgi param name
pvalue        = string                          ; fastcgi param value
authuser      = string                          ; authenticate user
authpass      = string                          ; authenticate password
mtype         = string                          ; MIME type (text/html -> text)
msubtype      = string                          ; MIME subtype (text/html -> html)

header        = "header" "remove" hname "always"
              / "header" "remove" hname
              / "header" "add" hname hvalue "always"
              / "header" "add" hname hvalue
              / "header" "set" hname hvalue "always"
              / "header" "set" hname hvalue

hsts          = "hsts" hstsflags
hstsflags     = *( hstsflag )
hstsflag      = "max-age" int
              / "subdomains"
              / "preload"

fastcgi       = "no" "fastcgi" fcgiflags
              / "fastcgi" fcgiflags
fcgiflags     = *( fcgiflag )
fcgiflag      = "socket" string
              / "socket" "tcp" string "port" int
              / "socket" "tcp" string
              / "param" pname pvalue
              / "strip" int
              / "pass" string

connection    = "connection" conflags
conflags      = *( conflag )
conflag       = "timeout" int
              / "request" "timeout" int
              / "max" "requests" int
              / "max" "request" "body" int

tls           = "tls" tlsopts
tlsopts       = *( tlsopt )
tlsopt        = "certificate" string
              / "key" string
              / "ocsp" string
              / "ciphers" string
              / "client" "ca" string tlsclientopts
              / "dhe" string
              / "ecdhe" string
              / "protocols" string
              / "ticket" "lifetime" "default"
              / "ticket" "lifetime" int
              / "no" "ticket"
tlsclientopts = *( tlsclientopt )
tlsclientopt  = "crl" string
              / "optional"

root          = "root" "{" rootflags "}"
              / "root" string
rootflags     = *( string )

request       = "request" requestflags
requestflags  = *( requestflag )
requestflag   = "rewrite" string
              / "no" "rewrite"
              / "strip" int

authenticate  = "authenticate" authuser "with" authpass
              / "authenticate" "with" authpass

directory     = "directory" dirflags
dirflags      = *( dirflag )
dirflag       = "index" string
              / "no" "index"
              / "auto" "index"
              / "no" "auto" "index"

logformat     = "log" logflags
              / "no" "log"
logflags      = *( logflag )
logflag       = "style" logstyle
              / "syslog"
              / "no" "syslog"
              / "access" string
              / "error" string
logstyle      = "common" / "combined" / "connection" / "forwarded"

filter        = "block" "return" int string
              / "block" "return" int
              / "block" "drop"
              / "pass"

tcpip         = "tcp" tcpflags
tcpflags      = *( tcpflag )
tcpflag       = "sack"
              / "no" "sack"
              / "nodelay"
              / "no" "nodelay"
              / "backlog" int
              / "socket" "buffer" int
              / "ip" string int

types         = "types" "{" mediaopts "}"
mediaopts     = *( mediaopt )
mediaopt      = mediastring medianames ";"
              / mediastring medianames
              / include
mediastring   = mtype "/" msubtype               ; a MIME type, e.g. text/html
medianames    = 1*( medianame )
medianame     = int / string
