; httpd.conf — OpenBSD httpd(8) configuration, as an ASTBNF schema.
; Translated from usr.sbin/httpd/parse.y (63 rules + 79 keyword tokens).
; Every `{ ... }` action — server/type registration, TAILQ bookkeeping,
; add_media() — is implicit: the binder builds the tree and the daemon walks
; it.  Only the shape survives, which is all the config really is.

config     = [ws] *( entry [ws] ) [ws]

entry      = "prefork" int
           / "chroot" str
           / "errdocs" str
           / "logdir" str
           / "no" "banner"
           / "default" "type" mediastring
           / server
           / types
           / "include" str
           / str "=" str                          ; varset (macro)

server     = "server" ["match"] str "{" [nl] *( serveropt nl ) [nl] "}"

; The ~20 things that can live inside a `server { }` block.
serveropt  = "listen" "on" str ["tls"] port
           / "alias" ["match"] str
           / "errdocs" str
           / "no" "errdocs"
           / tcpip
           / connection
           / tls
           / request
           / root
           / directory
           / "banner" / "no" "banner"
           / header
           / "static-cache-control" / "no" "static-cache-control"
           / logformat
           / fastcgi
           / authenticate
           / "gzip-static" / "no" "gzip-static"
           / filter
           / "location" [found] ["match"] str "{" [nl] *( serveropt nl ) [nl] "}"
           / "default" "type" mediastring
           / "include" str
           / hsts

port       = "port" ( int / str )                 ; a port number or service name

header     = "header" ( "remove" str ["always"]
                      / "add" str str ["always"]
                      / "set" str str ["always"] )

found      = "found" / "not" "found"              ; optfound, the "location" qualifier

hsts       = "hsts" *( sep ( "max-age" int
                            / "subdomains"
                            / "preload" ) )

fastcgi    = ["no"] "fastcgi" [*( sep fcgiflag )]
fcgiflag   = "socket" ( str / "tcp" str ["port" int] )
           / "param" str str
           / "strip" int
           / "pass" str

connection = "connection" [*( sep conflags )]
conflags   = "timeout" int
           / "request" "timeout" int
           / "max" "requests" int
           / "max" "request" "body" int

tls        = "tls" [*( sep tlsopts )]
tlsopts    = "certificate" str
           / "key" str
           / "ocsp" str
           / "ciphers" str
           / "client" "ca" str *( sep ( "crl" str / "optional" ) )
           / "dhe" str
           / "ecdhe" str
           / "protocols" str
           / "ticket" "lifetime" ( "default" / int )
           / "no" "ticket"

root       = "root" *( sep str )                  ; rootflags: one or more doc roots
request    = "request" [*( sep ( "rewrite" str / "no" "rewrite" / "strip" int ) )]

authenticate = "authenticate" ( str "with" str / "with" str )

directory  = "directory" [*( sep ( "index" str
                                 / "no" "index"
                                 / "auto" "index"
                                 / "no" "auto" "index" ) )]

logformat  = "log" [*( sep ( "style" logstyle
                           / "syslog" / "no" "syslog"
                           / "access" str
                           / "error" str ) )]
           / "no" "log"

logstyle   = "common" / "combined" / "connection" / "forwarded"

filter     = "block" ( "return" int [str] / "drop" )
           / "pass"

tcpip      = "tcp" [*( sep ( "sack" / "no" "sack"
                           / "nodelay" / "no" "nodelay"
                           / "backlog" int
                           / "socket" "buffer" int
                           / "ip" str int ) )]

types      = "types" "{" [nl] *( mediaopt nl ) [nl] "}"
mediaopt   = mediastring 1*( int / str ) [";"]
           / "include" str
mediastring = str "/" str                          ; a MIME type, e.g. "text/html"

nl         = "\n"                                 ; a newline — distinguishes lines
sep        = "," [nl] / nl                        ; comma-or-newline flag separator
ws         = 1*( nl / comment )                   ; entry separator: newline and/or comment
