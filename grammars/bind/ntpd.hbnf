; ntpd.conf bound to ntpd(8)'s own `struct ntpd_conf`: the grammar in
; ../ntpd.hbnf plus parse.y's tree actions as action jets.  The generated
; parse_config(filename, struct ntpd_conf *) is a drop-in for parse.y's:
;   hbnf_cli grammars/bind/ntpd.hbnf --backend=c --conf
; It compiles only against ntpd's headers (ntpd.h); the grammar itself stays
; standalone, so every backend and test can still use it.

language C
conf struct ntpd_conf

{
#include "ntpd.h"

/* parse.y's parser-internal state: the `query from` address (copied into each
   later server peer) and the constraint pool sequence number. */
static struct sockaddr_in  query_addr4;
static struct sockaddr_in6 query_addr6;
static int                 poolseqnum;
}

include "../ntpd.hbnf"

; parse.y's `main` actions, one case per directive (entry's kind tag).
; parse.y checks each option as it reads it and the first bad value discards
; the whole statement (YYERROR); here the options are checked first, in the
; same order and with the same messages, and bind_error + return drops the
; statement.  The parse tree is freed after the bind walk, so anything kept
; (refid) is copied.
action entry {
    struct ntp_addr *h = NULL, *next;
    long long weight = 1;
    int trusted = 0;

    if (n->kind == ENTRY_SERVERS || n->kind == ENTRY_SERVER) {
        serveropts_t *so;
        TAILQ_FOREACH(so, &n->serveropts, _link) {
            if (so->serveropt.kind == SERVEROPT_WEIGHT) {
                if (so->serveropt.int_ < 1 || so->serveropt.int_ > 10) {
                    bind_error("weight must be between 1 and 10");
                    return;
                }
                weight = so->serveropt.int_;
            } else
                trusted = 1;
        }
    }

    switch (n->kind) {
    case ENTRY_LISTEN: {
        struct listen_addr *la;
        listenopts_t *lo;
        int rtable = 0;
        TAILQ_FOREACH(lo, &n->listenopts, _link) {
            if (lo->rtable.int_ < 0 || lo->rtable.int_ > RT_TABLEID_MAX) {
                bind_error("rtable must be between 1 and RT_TABLEID_MAX");
                return;
            }
            rtable = (int)lo->rtable.int_;
        }
        host(n->address, &h);
        if (h == NULL && (host_dns(n->address, 0, &h) == -1 || !h)) {
            bind_error("could not resolve \"%s\"", n->address);
            return;
        }
        for (; h != NULL; h = next) {
            next = h->next;
            if ((la = calloc(1, sizeof *la)) == NULL)
                fatal("listen on calloc");
            la->fd = -1;
            la->rtable = rtable;
            memcpy(&la->sa, &h->ss, sizeof la->sa);
            TAILQ_INSERT_TAIL(&conf->listen_addrs, la, entry);
            free(h);
        }
        break;
    }
    case ENTRY_QUERY: {
        struct sockaddr_in sin4;
        struct sockaddr_in6 sin6;
        memset(&sin4, 0, sizeof sin4);
        sin4.sin_family = AF_INET;
        sin4.sin_len = sizeof sin4;
        memset(&sin6, 0, sizeof sin6);
        sin6.sin6_family = AF_INET6;
        sin6.sin6_len = sizeof sin6;
        if (inet_pton(AF_INET, n->address, &sin4.sin_addr) == 1)
            memcpy(&query_addr4, &sin4, sin4.sin_len);
        else if (inet_pton(AF_INET6, n->address, &sin6.sin6_addr) == 1)
            memcpy(&query_addr6, &sin6, sin6.sin6_len);
        else {
            /* parse.y's message, trailing newline included */
            bind_error("invalid IPv4 or IPv6 address: %s\n", n->address);
            return;
        }
        break;
    }
    case ENTRY_SERVERS: {
        struct ntp_peer *p;
        host(n->address, &h);
        do {
            if (h != NULL) {
                next = h->next;
                if (h->ss.ss_family != AF_INET &&
                    h->ss.ss_family != AF_INET6) {
                    bind_error("IPv4 or IPv6 address or hostname expected");
                    free(h);
                    return;
                }
                h->next = NULL;
            } else
                next = NULL;
            p = new_peer();
            p->weight = weight;
            p->trusted = trusted;
            conf->trusted_peers = conf->trusted_peers || trusted;
            p->query_addr4 = query_addr4;
            p->query_addr6 = query_addr6;
            p->addr = h;
            p->addr_head.a = h;
            p->addr_head.pool = ++poolseqnum;
            if ((p->addr_head.name = strdup(n->address)) == NULL)
                fatal(NULL);
            if (p->addr != NULL)
                p->state = STATE_DNS_DONE;
            TAILQ_INSERT_TAIL(&conf->ntp_peers, p, entry);
            h = next;
        } while (h != NULL);
        break;
    }
    case ENTRY_SERVER: {
        struct ntp_peer *p = new_peer();
        host(n->address, &h);
        for (; h != NULL; h = next) {
            next = h->next;
            if (h->ss.ss_family != AF_INET && h->ss.ss_family != AF_INET6) {
                bind_error("IPv4 or IPv6 address or hostname expected");
                free(h);
                free(p);
                return;
            }
            h->next = p->addr;
            p->addr = h;
        }
        p->weight = weight;
        p->trusted = trusted;
        conf->trusted_peers = conf->trusted_peers || trusted;
        p->query_addr4 = query_addr4;
        p->query_addr6 = query_addr6;
        p->addr_head.a = p->addr;
        p->addr_head.pool = 0;
        if ((p->addr_head.name = strdup(n->address)) == NULL)
            fatal(NULL);
        if (p->addr != NULL)
            p->state = STATE_DNS_DONE;
        TAILQ_INSERT_TAIL(&conf->ntp_peers, p, entry);
        break;
    }
    case ENTRY_CONSTRAINTS: {
        struct constraint *p;
        char *name, *path, *slash;
        const char *s = n->address;
        /* parse.y's url: split https://host/path; anything else is a host */
        if (strncmp(s, "https://", 8) == 0) {
            if ((name = strdup(s + 8)) == NULL)
                fatal("strdup");
            slash = name + strcspn(name, "/\\");
            if (*slash != '\0') {
                if ((path = strdup(slash)) == NULL)
                    fatal("strdup");
                *slash = '\0';
            } else if ((path = strdup("/")) == NULL)
                fatal("strdup");
        } else {
            if ((name = strdup(s)) == NULL || (path = strdup("/")) == NULL)
                fatal("strdup");
        }
        host(name, &h);
        do {
            if (h != NULL) {
                next = h->next;
                if (h->ss.ss_family != AF_INET &&
                    h->ss.ss_family != AF_INET6) {
                    bind_error("IPv4 or IPv6 address or hostname expected");
                    free(h);
                    free(name);
                    free(path);
                    return;
                }
                h->next = NULL;
            } else
                next = NULL;
            p = new_constraint();
            p->addr = h;
            p->addr_head.a = h;
            p->addr_head.pool = ++poolseqnum;
            p->addr_head.name = strdup(name);
            p->addr_head.path = strdup(path);
            if (p->addr_head.name == NULL || p->addr_head.path == NULL)
                fatal(NULL);
            if (p->addr != NULL)
                p->state = STATE_DNS_DONE;
            constraint_add(p);
            h = next;
        } while (h != NULL);
        free(name);
        free(path);
        break;
    }
    case ENTRY_CONSTRAINT: {
        struct constraint *p;
        struct ntp_addr **tail;
        urllist_t *sl;
        char *name = NULL, *path = NULL, *slash;
        int first = 1;
        /* parse.y's urllist: after the url, numeric addresses only */
        TAILQ_FOREACH(sl, &n->urllist, _link) {
            struct in_addr ina;
            struct in6_addr in6a;
            if (first) {
                first = 0;
                continue;
            }
            if (inet_pton(AF_INET, sl->address, &ina) != 1 &&
                inet_pton(AF_INET6, sl->address, &in6a) != 1) {
                bind_error("url can only be followed by IP addresses");
                return;
            }
        }
        p = new_constraint();
        tail = &p->addr;
        first = 1;
        TAILQ_FOREACH(sl, &n->urllist, _link) {
            h = NULL;
            if (first) {
                const char *s = sl->address;
                first = 0;
                if (strncmp(s, "https://", 8) == 0) {
                    if ((name = strdup(s + 8)) == NULL)
                        fatal("strdup");
                    slash = name + strcspn(name, "/\\");
                    if (*slash != '\0') {
                        if ((path = strdup(slash)) == NULL)
                            fatal("strdup");
                        *slash = '\0';
                    } else if ((path = strdup("/")) == NULL)
                        fatal("strdup");
                } else {
                    if ((name = strdup(s)) == NULL ||
                        (path = strdup("/")) == NULL)
                        fatal("strdup");
                }
                host(name, &h);
            } else
                host(sl->address, &h);
            if (h != NULL) {
                *tail = h;
                tail = &h->next;
            }
        }
        *tail = NULL;
        for (h = p->addr; h != NULL; h = h->next)
            if (h->ss.ss_family != AF_INET && h->ss.ss_family != AF_INET6) {
                bind_error("IPv4 or IPv6 address or hostname expected");
                free(name);
                free(path);
                return;
            }
        p->addr_head.a = p->addr;
        p->addr_head.pool = 0;
        p->addr_head.name = name;
        p->addr_head.path = path;
        if (p->addr != NULL)
            p->state = STATE_DNS_DONE;
        constraint_add(p);
        break;
    }
    case ENTRY_SENSOR: {
        struct ntp_conf_sensor *s;
        sensoropts_t *so;
        long long correction = 0, stratum = 1, sweight = 1;
        const char *refid = NULL;
        int strusted = 0;
        TAILQ_FOREACH(so, &n->sensoropts, _link) {
            long long v = so->sensoropt.int_;
            switch (so->sensoropt.kind) {
            case SENSOROPT_CORRECTION:
                if (v < -127000000 || v > 127000000) {
                    bind_error("correction must be between "
                        "-127000000 and 127000000 microseconds");
                    return;
                }
                correction = v;
                break;
            case SENSOROPT_REFID: {
                size_t l = strlen(so->sensoropt.string);
                if (l < 1 || l > 4) {
                    bind_error("refid must be 1 to 4 characters");
                    return;
                }
                refid = so->sensoropt.string;
                break;
            }
            case SENSOROPT_STRATUM:
                if (v < 1 || v > 15) {
                    bind_error("stratum must be between 1 and 15");
                    return;
                }
                stratum = v;
                break;
            case SENSOROPT_WEIGHT:
                if (v < 1 || v > 10) {
                    bind_error("weight must be between 1 and 10");
                    return;
                }
                sweight = v;
                break;
            case SENSOROPT_TRUSTED:
                strusted = 1;
                break;
            }
        }
        {
            /* new_sensor() takes a char * and copies it; parse.y hands it
               the lexer's string and frees that.  Do the same with a copy,
               rather than cast the tree's const away. */
            char *device = strdup(n->string);
            if (device == NULL)
                fatal(NULL);
            s = new_sensor(device);
            free(device);
        }
        s->weight = sweight;
        s->correction = correction;
        s->stratum = stratum;
        s->trusted = strusted;
        if (refid != NULL && (s->refstr = strdup(refid)) == NULL)
            fatal(NULL);
        conf->trusted_sensors = conf->trusted_sensors || strusted;
        TAILQ_INSERT_TAIL(&conf->ntp_conf_sensors, s, entry);
        break;
    }
    default:
        break;
    }
}

; parse.y's parse_config() resets the conf's list heads before the bind walk
; runs (the action jets TAILQ_INSERT into them, so they must be initialised).
; The C --conf wrapper calls conf_init() after setting `conf = xconf`.
{
static void conf_init(void) {
    TAILQ_INIT(&conf->listen_addrs);
    TAILQ_INIT(&conf->ntp_peers);
    TAILQ_INIT(&conf->ntp_conf_sensors);
    TAILQ_INIT(&conf->constraints);
}
}
