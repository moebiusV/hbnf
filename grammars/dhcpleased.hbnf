; dhcpleased.conf — OpenBSD dhcpleased(8) configuration, as an hbnf grammar.
; Translated from sbin/dhcpleased/parse.y.
;
;   %token keyword table   ->  "keyword" literals
;   STRING                 ->  string (str/word)
;   NUMBER                 ->  lexed but never accepted (no rule names NUMBER)
;   { ... } tree actions   ->  implicit — the binder builds the tree
;
; parse.y's `iface_block : optnl ifaceopts_l` block is a hoisted top-level list
; (`ifaceopts = *( ifaceopt )`) and the `{ iface_block }` body is the explicit
; `"{" ifaceopts "}"` — the same shape parse.y spells out, minus the newline
; scaffolding (the generated lexer skips newlines).
;
; The address / vendor-id / client-id checks (inet_pton, strnunvis, the hex
; client-id decode) all run in parse.y's actions, not in its scanner — there is
; no hand-written token here, so no jet.

language C
wordchars "*/$@%"
listops {
  head { TAILQ_HEAD(@name@, @elem@) }
  entry { TAILQ_ENTRY(@elem@) _link }
  init { TAILQ_INIT(@h@); }
  append { TAILQ_INSERT_TAIL(@h@, @e@, _link); }
  foreach { TAILQ_FOREACH(@v@, @h@, _link) }
  first { TAILQ_FIRST(@h@) }
  next { TAILQ_NEXT(@e@, _link) }
  relink { if (TAILQ_EMPTY(@h@)) TAILQ_INIT(@h@); else TAILQ_FIRST(@h@)->_link.tqe_prev = &TAILQ_FIRST(@h@); }
}

{
#include <sys/queue.h>
}

include "commonconf.hbnf"



config     = *( entry )

entry      = varset
           / interface

; one or more STRING tokens (parse.y's `string : string STRING | STRING`)
stringlist = 1*string

varset     = string "=" stringlist                ; macro name = value…

interface  = "interface" string "{" ifaceopts "}"
ifaceopts  = *( ifaceopt )

ifaceopt   = "send" "vendor" "class" "id" string
           / "send" "client" "id" string
           / "send" "host" "name" string
           / "send" "no" "host" "name"
           / "ignore" "routes"
           / "ignore" "dns"
           / "ignore" string
           / "prefer" "ipv6"
