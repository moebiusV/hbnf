#!/bin/sh
# pre-commit - keep a repository's generated Pages files (*.html and .nojekyll, made by
# mkpages.sh) in step with its Markdown.  When a .md file is in the commit, rebuild the
# pages and add the ones that changed.
#
#   install:  cp corpus/markdown/pre-commit YOUR_REPO/.git/hooks/pre-commit
#   needs:    a built hbnf; HBNF_DIR names it (default: ../hbnf beside the repository)
#
# Without hbnf the commit is refused rather than leaving the pages stale; git commit
# --no-verify skips the hook.
git diff --cached --name-only --diff-filter=ACMRD | grep -q '\.md$' || exit 0

root=$(git rev-parse --show-toplevel) || exit 1
HBNF_DIR=${HBNF_DIR:-$root/../hbnf}
if [ ! -x "$HBNF_DIR/hbnf" ] || ! HBNF_DIR=$HBNF_DIR sh "$HBNF_DIR/corpus/markdown/mkpages.sh" "$root" >/dev/null; then
	echo >&2 "pre-commit: the Pages files were not rebuilt (is HBNF_DIR a built hbnf?)."
	echo >&2 "Set HBNF_DIR, or commit with --no-verify."
	exit 1
fi

cd "$root" || exit 1
# stage the pages mkpages made or changed (only files that carry its marker), and the ones it removed
git ls-files -m -o --exclude-standard -- '*.html' .nojekyll | while IFS= read -r f; do
	case "$f" in .nojekyll) git add -- "$f" ;; *) head -3 "$f" | grep -q '^<!-- generated from ' && git add -- "$f" ;; esac
done
git ls-files -d -- '*.html' | while IFS= read -r f; do git add -A -- "$f"; done
exit 0
