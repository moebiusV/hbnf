    close = strchr(q + 1, quoted ? '"' : '>');
    if (!close) { free(t); return 0; }
    { size_t m = (size_t)(close - q - 1); char *name = cpp_dup(q + 1, m);
      if (cpp_ndirs == 0) cpp_dirs[cpp_ndirs++] = cpp_dirof(cpp_file);
      e->path = cpp_find(name, quoted, 0, &idx);
      free(name); }
    q = close + 1;
    for (;;) {
        char *nm, *pe;
        char word[64];
        size_t wl = 0;
        const char *args = NULL;
        size_t al = 0;
        while (*q == ' ' || *q == '\t') q++;
        if (!*q) break;
        nm = q;
        while (isalnum((unsigned char)*q) || *q == '_' || *q == ':') q++;
        if (q == nm) { free(t); return -1; }
        wl = (size_t)(q - nm);
        if (wl >= sizeof word) { free(t); return -1; }
        memcpy(word, nm, wl);  word[wl] = 0;
        while (*q == ' ' || *q == '\t') q++;
        if (*q == '(') {
            int d = 0;
            pe = q;
            do { if (*pe == '(') d++; else if (*pe == ')') d--; pe++; } while (*pe && d > 0);
            if (d != 0) { free(t); return -1; }
            args = q + 1;  al = (size_t)(pe - q - 2);
            q = pe;
        }
        { char *w = word;  size_t k;
          if (strncmp(w, "gnu::", 5) == 0) w += 5;
          if (strncmp(w, "__gnu__::", 9) == 0) w += 9;
          k = strlen(w);
          if (k > 4 && w[0] == '_' && w[1] == '_' && w[k - 1] == '_' && w[k - 2] == '_') { w[k - 2] = 0; w += 2; }
          if (strcmp(w, "limit") == 0 && args) { if (!cpp_eval_int(args, al, &e->limit)) { free(t); return -1; } }
          else if (strcmp(w, "offset") == 0 && args) { if (!cpp_eval_int(args, al, &e->offset)) { free(t); return -1; } }
          else if (strcmp(w, "prefix") == 0) e->prefix = cpp_trim(args ? args : "", al);
          else if (strcmp(w, "suffix") == 0) e->suffix = cpp_trim(args ? args : "", al);
          else if (strcmp(w, "if_empty") == 0) e->if_empty = cpp_trim(args ? args : "", al);
          else { cpp_diag(at, "error", "unknown '#embed' parameter '%s'", word); free(t); return -1; }
        }
