    return cpp_dup("\n", 1);
}
static char *cpp_unassert_dir(const char *s, size_t n) {
    char *t = cpp_trim(s, n);
    char *lp = strchr(t, '('), *rp = lp ? strrchr(t, ')') : NULL;
    char *pred = cpp_as_trim(t, lp ? (size_t)(lp - t) : strlen(t)), *ans = (lp && rp) ? cpp_as_trim(lp + 1, (size_t)(rp - lp - 1)) : NULL;
    int i, k = 0;
    for (i = 0; i < cpp_nas; i++) {
        if (strcmp(cpp_as_pred[i], pred) == 0 && (!ans || strcmp(cpp_as_ans[i], ans) == 0)) { free(cpp_as_pred[i]);  free(cpp_as_ans[i]); }
        else { cpp_as_pred[k] = cpp_as_pred[i];  cpp_as_ans[k] = cpp_as_ans[i];  k++; }
    }
    cpp_nas = k;
    free(pred);  free(ans);  free(t);
