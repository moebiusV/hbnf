}
static void hbnf_map_from(const size_t *map, size_t n);
static unsigned hbnf_rr_count(void);
static int hbnf_rr_pending(void);   /* the runtime of the rewrites: a rewrite is waiting to be made */
static void (*hbnf_paste_hook)(const char *at, const char *name, size_t nl, const char *l, size_t ln, const char *r, size_t rn);
static void cpp_paste_bad(const char *at, const char *name, size_t nl, const char *l, size_t ln, const char *r, size_t rn);
static void cpp_arity(const char *at, const char *name, size_t nl, int np, int na, int variadic);   /* the epilogue: a call against what the macro takes */
static void cpp_define_check(const char *text, size_t len);   /* the epilogue: what a #define says, against what the name is */
static size_t hbnf_inc_depth(const char *s);   /* the runtime of the rewrites: how many includes the place is in */
static char *cpp_predef(const char *s, size_t n);   /* the epilogue: it seeds the macros every compiler has */
/* Translation phases 1 and 2: trigraphs (when the host asks for them: cpp_trigraphs, as -trigraphs or -std=c11 does) and a backslash before a newline
   are taken out of the whole text first, once; the places that were taken out are kept, so that a line number is still the line the user wrote. */
int cpp_trigraphs = 0;
int cpp_std = -1;           /* the standard of -std= (an index of cpp_gnu_stds), or -1 for gcc's default */
int cpp_set_std(const char *name) {   /* -std=NAME: 1 if it is one the tables have (gcc's aliases c90, c18, gnu90, gnu18 too) */
    size_t i;
    static const char *alias[][2] = { { "c90", "c89" }, { "iso9899:1990", "c89" }, { "c18", "c17" }, { "iso9899:2017", "c17" }, { "iso9899:2018", "c17" }, { "gnu90", "gnu89" },
                                      { "gnu18", "gnu17" }, { "iso9899:1999", "c99" }, { "iso9899:2011", "c11" }, { "c9x", "c99" }, { "c1x", "c11" }, { "gnu9x", "gnu99" },
                                      { "gnu1x", "gnu11" }, { "c2x", "c23" }, { "gnu2x", "gnu23" } };
    for (i = 0; i < sizeof alias / sizeof *alias; i++) if (strcmp(name, alias[i][0]) == 0) name = alias[i][1];
    for (i = 0; i < sizeof cpp_gnu_stds / sizeof *cpp_gnu_stds; i++) if (strcmp(name, cpp_gnu_stds[i]) == 0) { cpp_std = (int)i; return 1; }
    return 0;
}
static int cpp_trigraph(const char *s, char *to) {
    static const char from[] = "=(/)'<!>-", mapto[] = "#[\\]^{|}~";
    const char *q;
    if (s[0] != '?' || s[1] != '?') return 0;
    q = strchr(from, s[2]);
    if (!q || !s[2]) return 0;
    *to = mapto[q - from];
    return 1;
}
/* the length of a splice at s (a backslash, blanks, a newline), or 0 */
static size_t cpp_splice_len(const char *s, const char *e) {
    const char *q = s + 1;
    if (s >= e || *s != '\\') return 0;
    while (q < e && (*q == ' ' || *q == '\t')) q++;
    if (q < e && *q == '\r' && q + 1 < e && q[1] == '\n') return (size_t)(q + 2 - s);
    if (q < e && (*q == '\n' || *q == '\r')) return (size_t)(q + 1 - s);
    return 0;
}
static int cpp_needs_unsplice(const char *s, size_t n) {
    size_t i;
    for (i = 0; i < n; i++) {
        char c;
        if (s[i] == '\\' && cpp_splice_len(s + i, s + n)) return 1;
        if (cpp_trigraphs && s[i] == '?' && i + 2 < n + 0 && cpp_trigraph(s + i, &c)) return 1;
    }
    return 0;
}
static char *cpp_unsplice(const char *s, size_t n) {
    char *r = (char *)malloc(n + 1);
    size_t *map = (size_t *)malloc(2 * (n + 1) * sizeof *map);
    size_t i = 0, k = 0, nm = 0;
    while (i < n) {
        char c;
        size_t sl = 0;
        if (cpp_trigraphs && i + 2 < n && cpp_trigraph(s + i, &c)) {
            if (c == '\\' && (sl = cpp_splice_len(&c, &c + 1)) == 0 && i + 3 < n) { /* a trigraph backslash before a newline is a splice, too */ }
            r[k++] = c;  map[2 * nm] = k;  map[2 * nm + 1] = 2;  nm++;  i += 3;
            continue;
        }
        sl = cpp_splice_len(s + i, s + n);
        if (sl) { map[2 * nm] = k;  map[2 * nm + 1] = sl;  nm++;  i += sl;  continue; }
        r[k++] = s[i++];
    }
    r[k] = 0;
    /* a trigraph that made a backslash can make a splice: go round once more over what is left (the places of the second go are not kept apart) */
    hbnf_map_from((const size_t *)hbnf_src_keep((char *)map), nm);
    return r;
}
/* A directive that is taken out of the text leaves a newline in its place, not nothing: two empty replacements in a row at one place are
   more than the retry of a rewrite reads again.
   Diagnostics.  `FILE:LINE: error: message` (or warning, or fatal error) on the standard error, with FILE and LINE the file and line of the text the user
   wrote, and counted in cpp_errors and cpp_warnings; the host may take them instead (cpp_diag_hook).  What a directive reports is taken out of the text,
   and the text goes on.  A diagnostic is given once for a line and message (a parse that reads a place again does not say it again). */
#include <stdarg.h>
int cpp_errors = 0, cpp_warnings = 0;
void (*cpp_diag_hook)(const char *file, size_t line, const char *kind, const char *msg) = NULL;
static char *cpp_seen_diag[512];  static int cpp_nseen_diag;
static void cpp_diag(const char *at, const char *kind, const char *fmt, ...) {
    char msg[1024], key[1400];
    const char *f;
    size_t line;
    int i;
    va_list ap;
    /* a rewrite is waiting: what is read after the alternative that asked for it (and its template functions too) is not what is meant, and says nothing */
    if (hbnf_rr_pending()) return;
    line = hbnf_orig_place(at, &f);
    va_start(ap, fmt);  vsnprintf(msg, sizeof msg, fmt, ap);  va_end(ap);
    snprintf(key, sizeof key, "%lu|%s|%s", (unsigned long)line, kind, msg);
    for (i = 0; i < cpp_nseen_diag; i++) if (strcmp(cpp_seen_diag[i], key) == 0) return;
    if (cpp_nseen_diag < 512) cpp_seen_diag[cpp_nseen_diag++] = strdup(key);
    if (kind[0] == 'w') cpp_warnings++; else cpp_errors++;
    if (cpp_diag_hook) cpp_diag_hook(f ? f : cpp_file, line, kind, msg);
    else fprintf(stderr, "%s:%lu: %s: %s\n", f ? f : cpp_file, (unsigned long)line, kind, msg);
}
static void cpp_diag_at(const char *file, size_t line, const char *kind, const char *fmt, ...) {
    char msg[1024], key[1400];
    int i;
    va_list ap;
    if (hbnf_rr_pending()) return;
    va_start(ap, fmt);  vsnprintf(msg, sizeof msg, fmt, ap);  va_end(ap);
    snprintf(key, sizeof key, "%s|%lu|%s|%s", file ? file : "", (unsigned long)line, kind, msg);
    for (i = 0; i < cpp_nseen_diag; i++) if (strcmp(cpp_seen_diag[i], key) == 0) return;
    if (cpp_nseen_diag < 512) cpp_seen_diag[cpp_nseen_diag++] = strdup(key);
    if (kind[0] == 'w') cpp_warnings++; else cpp_errors++;
    if (cpp_diag_hook) cpp_diag_hook(file ? file : cpp_file, line, kind, msg);
    else fprintf(stderr, "%s:%lu: %s: %s\n", file ? file : cpp_file, (unsigned long)line, kind, msg);
}
/* where each macro was defined (a message about its replacement is said there) */
static char *cpp_def_name[4096];  static size_t cpp_def_nl[4096];  static size_t cpp_def_line[4096];  static const char *cpp_def_file[4096];  static int cpp_ndef;
static void cpp_note_def(const char *name, size_t nl, const char *at) {
    const char *f;
    size_t line = hbnf_orig_place(at, &f);
    int i;
    for (i = cpp_ndef - 1; i >= 0; i--) if (cpp_def_nl[i] == nl && memcmp(cpp_def_name[i], name, nl) == 0) { cpp_def_line[i] = line;  cpp_def_file[i] = f ? f : cpp_file;  return; }
    if (cpp_ndef >= 4096) return;
    cpp_def_name[cpp_ndef] = cpp_dup(name, nl);  cpp_def_nl[cpp_ndef] = nl;  cpp_def_line[cpp_ndef] = line;  cpp_def_file[cpp_ndef] = f ? f : cpp_file;  cpp_ndef++;
}
/* the text of the rest of a directive's line, without the blanks round it */
static char *cpp_trim(const char *s, size_t n) {
    while (n > 0 && (s[0] == ' ' || s[0] == '\t')) { s++; n--; }
    while (n > 0 && (s[n - 1] == ' ' || s[n - 1] == '\t' || s[n - 1] == '\n' || s[n - 1] == '\r')) n--;
    return cpp_dup(s, n);
}
/* reports that leave the text as it is (the directive is one the output has no more of: cpp_output takes out every line of directive that is left) */
static void cpp_say(const char *at, const char *msg) { cpp_diag(at, "error", "%s", msg); }
/* `text` is the directive as far as the rule has read it, from its `#`: the keyword after the `#` and what follows it, blanks and comments passed over */
static const char *cpp_dir_word(const char *s, size_t n, size_t *wl, const char **rest) {
    const char *e = s + n, *w;
    s += (s < e && *s == '%') ? 2 : 1;
    for (;;) {
        if (s < e && (*s == ' ' || *s == '\t')) s++;
        else if (s + 1 < e && s[0] == '/' && s[1] == '*') { s += 2; while (s + 1 < e && !(s[0] == '*' && s[1] == '/')) s++; s += 2; }
        else break;
    }
    w = s;
    while (s < e && (isalnum((unsigned char)*s) || *s == '_')) s++;
    *wl = (size_t)(s - w);
    while (s < e && (*s == ' ' || *s == '\t')) s++;
    *rest = s > e ? e : s;
    return w;
}
static void cpp_say_text(const char *at, size_t n, const char *kind, const char *prefix) {   /* `#error text`, `#warning text`, `invalid preprocessing directive #name` */
    size_t wl;
    const char *rest, *w = cpp_dir_word(at, n, &wl, &rest);
    char *t, *kw = cpp_dup(w, wl);
    if (prefix[0] == '#') { t = cpp_trim(rest, (size_t)(at + n - rest)); cpp_diag(at, kind, "#%s %s", kw, t); free(t); }
    else cpp_diag(at, kind, "%s%s", prefix, kw);
    free(kw);
}
static void cpp_say_stray(const char *at, size_t n) {
    size_t wl;
    const char *rest, *w = cpp_dir_word(at, n, &wl, &rest);
    char *kw = cpp_dup(w, wl);
    cpp_diag(at, "error", "'#%s' without '#if'", kw);
    free(kw);
}
/* a call whose argument list does not end: `text` is `NAME (`, what the rule has read */
static void cpp_unterm_call(const char *text) {
    char name[256];
    size_t k = 0;
    while (k + 1 < sizeof name && (isalnum((unsigned char)text[k]) || text[k] == '_')) { name[k] = text[k]; k++; }
    name[k] = 0;
    cpp_diag(text, "error", "unterminated argument list invoking macro '%s'", name);
}
static char *cpp_dirof(const char *path) {
    const char *sl = strrchr(path, '/');
    size_t n = sl ? (size_t)(sl - path) : 0;
    char *d = (char *)malloc(n + 1);
    memcpy(d, path, n);  d[n] = 0;
    return d;
}
static char *cpp_slurp(const char *path) {
    FILE *f = fopen(path, "rb");
    char *b;
    long n;
    if (!f) return NULL;
    fseek(f, 0, SEEK_END);  n = ftell(f);  fseek(f, 0, SEEK_SET);
    if (n < 0) { fclose(f); return NULL; }
    b = (char *)malloc((size_t)n + 2);
    if (fread(b, 1, (size_t)n, f) != (size_t)n) { fclose(f); free(b); return NULL; }
    fclose(f);
    if (n > 0 && b[n - 1] != '\n') b[n++] = '\n';
    b[n] = 0;
    return b;
}
static char *cpp_try(const char *dir, const char *name, char **found) {
    char path[8192];
    char *t;
    if (dir[0]) snprintf(path, sizeof path, "%s/%s", dir, name); else snprintf(path, sizeof path, "%s", name);
    t = cpp_slurp(path);
    if (t) *found = strdup(path);
    return t;
}
/* Where an include file is looked for.  `#include "x"`: the directory of each file read so far, the newest first, then the directories of the angle chain;
   `#include <x>`: the angle chain only: the directories the host gave to cpp_add_incdir (-I), then the system directories (gcc's, from tools/gen_gcc_tables.py)
   unless the host set cpp_nostdinc (-nostdinc).  `#include_next` goes on in the chain after the directory the current file was found in. */
int cpp_nostdinc = 0;
static int cpp_chain_n(void) { return cpp_nincdirs + (cpp_nostdinc ? 0 : (int)(sizeof cpp_gnu_sysdirs / sizeof *cpp_gnu_sysdirs)); }
static const char *cpp_chain_dir(int k) { return k < cpp_nincdirs ? cpp_incdirs[k] : cpp_gnu_sysdirs[k - cpp_nincdirs]; }
static char *cpp_fpath[256];  static int cpp_fidx[256];  static int cpp_nf;   /* the files read, and where in the angle chain each was found (-1: elsewhere) */
static int cpp_file_idx(const char *path) {
    int i;
    for (i = 0; i < cpp_nf; i++) if (strcmp(cpp_fpath[i], path) == 0) return cpp_fidx[i];
    return -1;
}
static char *cpp_find(const char *name, int quoted, int from, int *idx) {
    char *found = NULL, *t;
    int k;
    *idx = -1;
    if (name[0] == '/') { t = cpp_try("", name, &found); if (t) { free(t); return found; } return NULL; }
    if (quoted && from == 0) for (k = cpp_ndirs - 1; k >= 0; k--) { t = cpp_try(cpp_dirs[k], name, &found); if (t) { free(t); return found; } }
    for (k = from; k < cpp_chain_n(); k++) { t = cpp_try(cpp_chain_dir(k), name, &found); if (t) { free(t); *idx = k; return found; } }
    return NULL;
}
/* the file the place s is in: an included file's path, or the main file's name */
static const char *cpp_file_of(const char *s) { const char *f; hbnf_orig_place(s, &f); return f ? f : cpp_file; }
/* `#include` (next: `#include_next`, once: `#import`): the text of the file, left for the grammar to read; a file `#pragma once` was read in is nothing */
static char *cpp_include_k(const char *s, size_t n, const char *at, int next, int once) {
    char name[4096];
    char *text = NULL, *found = NULL;
    int quoted = n > 0 && s[0] == '"', idx = -1;
    if (n < 3 || n >= sizeof name) return cpp_dup("#error invalid #include\n", 24);
    memcpy(name, s + 1, n - 2);  name[n - 2] = 0;
    if (cpp_ndirs == 0) cpp_dirs[cpp_ndirs++] = cpp_dirof(cpp_file);
    found = cpp_find(name, quoted && !next, next ? cpp_file_idx(cpp_file_of(at)) + 1 : 0, &idx);
    if (found) text = cpp_slurp(found);
    if (!text) { free(found);  cpp_diag(at, "fatal error", "%s: No such file or directory", name);  return cpp_dup("\n", 1); }
    { char *d = cpp_dirof(found);  int i, seen = 0;
      for (i = 0; i < cpp_ndirs; i++) if (strcmp(cpp_dirs[i], d) == 0) seen = 1;
      if (!seen && cpp_ndirs < 64) cpp_dirs[cpp_ndirs++] = d; else free(d); }
    if (cpp_nf < 256 && cpp_file_idx(found) < 0) { cpp_fpath[cpp_nf] = strdup(found);  cpp_fidx[cpp_nf++] = idx; }
    if (cpp_once_has(found)) { free(text);  free(found);  return cpp_dup("\n", 1); }   /* `#pragma once` was read in it */
    if (once) cpp_once_add(found);
    hbnf_text_from(hbnf_src_keep(found), hbnf_src_keep(strdup(text)));
    /* the file is read as the main file is: trigraphs and `\`-newline taken out first (phases 1 and 2), the places kept for its lines */
    if (cpp_needs_unsplice(text, strlen(text))) { char *proc = cpp_unsplice(text, strlen(text));  free(text);  text = proc; }
    return text;
