    while (*after && *after != '\n') after++;
    if (*after) after++;
    no = strtoul(t, &e, 10);
    if (e == t || no == 0 && 0) {
        { char *w = t; while (*w && *w != ' ' && *w != '\t') w++;  *w = 0; }
        if (t[0]) cpp_diag(s, "error", "'%s' after '#line' is not a positive integer", t); else cpp_diag(s, "error", "unexpected end of file after '#line'");
        free(t);
        return cpp_dup("\n", 1);
    }
    while (*e == ' ' || *e == '\t') e++;
    if (*e == '"') { size_t m = strlen(e);  cpp_linefile = hbnf_src_keep(cpp_destring(e, m)); }
    hbnf_line_add(hbnf_orig_offset(after), (size_t)no, cpp_linefile);
    free(t);
    return cpp_dup("\n", 1);
}
static char *cpp_assert_dir(const char *s, size_t n) {
    char *t = cpp_trim(s, n);
    char *lp = strchr(t, '('), *rp = lp ? strrchr(t, ')') : NULL;
    if (lp && rp && cpp_nas < 256) { cpp_as_pred[cpp_nas] = cpp_as_trim(t, (size_t)(lp - t));  cpp_as_ans[cpp_nas] = cpp_as_trim(lp + 1, (size_t)(rp - lp - 1));  cpp_nas++; }
    else cpp_diag(s, "error", "missing '(' after predicate");
