static char *cpp_include(const char *s, size_t n) { return cpp_include_k(s, n, s, 0, 0); }
/* `#embed "file" params` (C23): the bytes of the file as a list of numbers, the operand read once its macros are expanded.  Parameters: limit(n), gnu::offset(n),
   prefix(tokens), suffix(tokens), if_empty(tokens) (and the `__name__` spellings): prefix and suffix go before and after the numbers when there are some, and
   if_empty stands for them when there are none.  `__has_embed` asks the same without reading it all: 0 not found, 1 found, 2 found and empty. */
static int cpp_eval_int(const char *s, size_t n, intmax_t *out);
typedef struct { char *path; intmax_t limit, offset; char *prefix, *suffix, *if_empty; int ok; } cpp_embed_t;
static void cpp_embed_free(cpp_embed_t *e) { free(e->path); free(e->prefix); free(e->suffix); free(e->if_empty); }
static int cpp_embed_parse(const char *s, size_t n, const char *at, cpp_embed_t *e) {
