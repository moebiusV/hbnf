; The tokens of C11 (ISO/IEC 9899:2011 6.4) as rules of characters.  Nothing here skips white
; space; c11.hbnf, which includes this file, does that between tokens.  Keywords are the
; literals of the grammar, matched whole by `word` (letters, digits and _), which is why this
; file defines `word`: the built-in one also takes - and ., and `return-1` is `return` and `-1`.
prefix none
whitespace none
include "../../grammars/common.hbnf"

BS     = %x5C
SQUOTE = %x27

idstart    = ALPHA | "_"
idchar     = ALPHA | DIGIT | "_"
word       = idstart *idchar
keyword    = "auto" | "break" | "case" | "char" | "const" | "continue" | "default" | "do" | "double"
           | "else" | "enum" | "extern" | "float" | "for" | "goto" | "if" | "inline" | "int" | "long"
           | "register" | "restrict" | "return" | "short" | "signed" | "sizeof" | "static" | "struct"
           | "switch" | "typedef" | "union" | "unsigned" | "void" | "volatile" | "while" | "_Alignas"
           | "_Alignof" | "_Atomic" | "_Bool" | "_Complex" | "_Generic" | "_Imaginary" | "_Noreturn"
           | "_Static_assert" | "_Thread_local" | "__builtin_va_list" | "__int128_t" | "__uint128_t" | "_Float16" | "__bf16" | "_Float32" | "_Float64" | "_Float128" | "_Float32x" | "_Float64x" | "_Decimal32" | "_Decimal64" | "_Decimal128" | "__float128"
identifier = word - keyword

; ---- constants (6.4.4) ----
; (the letters inside a token are written as code points: a letter-led literal is a whole word)
constant   = floating-constant | integer-constant | character-constant
ex         = %x78 | %x58
bee        = %x62 | %x42
you        = %x75 | %x55
ell        = %x6C | %x4C
eee        = %x65 | %x45
pee        = %x70 | %x50
eff        = %x66 | %x46
sign       = %x2B | %x2D
imag       = %x69 | %x49 | %x6A | %x4A
int-suffix = you | ell | imag
digits     = 1*DIGIT
hexd       = DIGIT | %x41-46 | %x61-66
hexdigits  = 1*hexd
bin-digit  = %x30 | %x31
integer-constant = ( %x30 ex hexdigits | %x30 bee 1*bin-digit | digits ) *int-suffix
floating-constant = ( dec-float | hex-float ) *fsuffix
fdigit     = DIGIT | ex
fsuffix    = eff *fdigit | ell | imag
dec-float  = digits %x2E *DIGIT [ exponent ] | %x2E digits [ exponent ] | digits exponent
exponent   = eee [ sign ] digits
hex-float  = %x30 ex hex-mantissa pee [ sign ] digits
hex-mantissa = hexdigits %x2E *hexd | hexdigits | %x2E hexdigits
char-prefix = %x4C | you
char-body  = ~( SQUOTE | BS | LF ) | BS ~LF
character-constant = [ char-prefix ] SQUOTE 1*char-body SQUOTE

; ---- string literals (6.4.5) ----
str-prefix = you %x38 | %x4C | you
str-body   = ~( DQUOTE | BS | LF ) | BS ( LF | ~LF )
string-literal = [ str-prefix ] DQUOTE *str-body DQUOTE

; ---- GNU extensions that system headers and real code use ----
; The text of a parenthesised argument list up to the ")" that closes it: parentheses balance and
; the contents of string and character literals do not count.
balanced = C {
    size_t i = pos, d = 0;
    while (i < len) {
        unsigned char c = (unsigned char)s[i];
        if (c == 34 || c == 39) { unsigned char q = c; i++; while (i < len && (unsigned char)s[i] != q) { if (s[i] == 92) i++; i++; } i++; continue; }
        if (c == 40) d++;
        else if (c == 41) { if (d == 0) return i - pos; d--; }
        i++;
    }
    return 0;
}
balanced = Rust {
    let mut i = pos;
    let mut d = 0usize;
    while i < len {
        let c = s[i];
        if c == 34 || c == 39 { let q = c; i += 1; while i < len && s[i] != q { if s[i] == 92 { i += 1; } i += 1; } i += 1; continue; }
        if c == 40 { d += 1; }
        else if c == 41 { if d == 0 { return i - pos; } d -= 1; }
        i += 1;
    }
    0
}
balanced = Zig {
    var i: usize = pos;
    var d: usize = 0;
    while (i < len) {
        const c = s[i];
        if (c == 34 or c == 39) {
            i += 1;
            while (i < len and s[i] != c) { if (s[i] == 92) i += 1; i += 1; }
            i += 1;
            continue;
        }
        if (c == 40) {
            d += 1;
        } else if (c == 41) {
            if (d == 0) return i - pos;
            d -= 1;
        }
        i += 1;
    }
    return 0;
}
balanced = Ada {
      I : Natural := Pos;
      D : Natural := 0;
   begin
      while I <= Len loop
         if Character'Pos (S (I)) = 34 or else Character'Pos (S (I)) = 39 then
            declare
               Q : constant Character := S (I);
            begin
               I := I + 1;
               while I <= Len and then S (I) /= Q loop
                  if Character'Pos (S (I)) = 92 then I := I + 1; end if;
                  I := I + 1;
               end loop;
               I := I + 1;
            end;
         else
            if Character'Pos (S (I)) = 40 then
               D := D + 1;
            elsif Character'Pos (S (I)) = 41 then
               if D = 0 then return I - Pos; end if;
               D := D - 1;
            end if;
            I := I + 1;
         end if;
      end loop;
      return 0;
}

; White space between tokens (6.4.9 comments too), and what the GNU compilers read as such: an
; attribute list, an assembler label (__asm__ ("name")) and __extension__.  One scanner, since it is
; run between every two tokens: it takes everything of these it finds in a row.
ws = C {
    size_t i = pos;
    while (i < len) {
        unsigned char c = (unsigned char)s[i];
        if (c == 32 || (c >= 9 && c <= 13)) { i++; continue; }
        if (c == 47 && i + 1 < len && s[i + 1] == 42) {
            size_t j = i + 2;
            while (j + 1 < len && !(s[j] == 42 && s[j + 1] == 47)) j++;
            if (j + 1 >= len) break;
            i = j + 2; continue;
        }
        if (c == 47 && i + 1 < len && s[i + 1] == 47) { while (i < len && s[i] != 10) i++; continue; }
        if (c == 35) { while (i < len && s[i] != 10) i++; continue; }   /* #pragma, # line: what the preprocessor leaves */
        if (c == 91 && i + 1 < len && s[i + 1] == 91) {   /* [[ attribute ]] */
            size_t j = i + 2;
            while (j + 1 < len && !(s[j] == 93 && s[j + 1] == 93)) j++;
            if (j + 1 >= len) break;
            i = j + 2; continue;
        }
        if (c == 95) {
            size_t j = i, k, m, d = 0;
            while (j < len && (s[j] == 95 || (s[j] >= 48 && s[j] <= 57) || (s[j] >= 65 && s[j] <= 90) || (s[j] >= 97 && s[j] <= 122))) j++;
            if (j - i == 13 && memcmp(s + i, "__extension__", 13) == 0) { i = j; continue; }
            if ((j - i == 13 && memcmp(s + i, "__attribute__", 13) == 0) || (j - i == 11 && memcmp(s + i, "__attribute", 11) == 0)
                || (j - i == 7 && memcmp(s + i, "__asm__", 7) == 0) || (j - i == 5 && memcmp(s + i, "__asm", 5) == 0)) {
                k = j;
                while (k < len && (s[k] == 32 || (s[k] >= 9 && s[k] <= 13))) k++;
                if (k < len && s[k] == 40) {
                    for (m = k; m < len; m++) {
                        unsigned char q = (unsigned char)s[m];
                        if (q == 34 || q == 39) { m++; while (m < len && (unsigned char)s[m] != q) { if (s[m] == 92) m++; m++; } continue; }
                        if (q == 40) d++;
                        else if (q == 41) { d--; if (d == 0) break; }
                    }
                    if (m < len) { i = m + 1; continue; }
                }
            }
        }
        break;
    }
    return i - pos;
}
ws = Rust {
    let mut i = pos;
    while i < len {
        let c = s[i];
        if c == 32 || (c >= 9 && c <= 13) { i += 1; continue; }
        if c == 47 && i + 1 < len && s[i + 1] == 42 {
            let mut j = i + 2;
            while j + 1 < len && !(s[j] == 42 && s[j + 1] == 47) { j += 1; }
            if j + 1 >= len { break; }
            i = j + 2; continue;
        }
        if c == 47 && i + 1 < len && s[i + 1] == 47 { while i < len && s[i] != 10 { i += 1; } continue; }
        if c == 35 { while i < len && s[i] != 10 { i += 1; } continue; }
        if c == 91 && i + 1 < len && s[i + 1] == 91 {
            let mut j = i + 2;
            while j + 1 < len && !(s[j] == 93 && s[j + 1] == 93) { j += 1; }
            if j + 1 >= len { break; }
            i = j + 2; continue;
        }
        if c == 95 {
            let mut j = i;
            while j < len && (s[j] == 95 || s[j].is_ascii_alphanumeric()) { j += 1; }
            let w = &s[i..j];
            if w == b"__extension__" { i = j; continue; }
            if w == b"__attribute__" || w == b"__attribute" || w == b"__asm__" || w == b"__asm" {
                let mut k = j;
                while k < len && (s[k] == 32 || (s[k] >= 9 && s[k] <= 13)) { k += 1; }
                if k < len && s[k] == 40 {
                    let mut d = 0usize;
                    let mut m = k;
                    while m < len {
                        let q = s[m];
                        if q == 34 || q == 39 { m += 1; while m < len && s[m] != q { if s[m] == 92 { m += 1; } m += 1; } m += 1; continue; }
                        if q == 40 { d += 1; }
                        else if q == 41 { d -= 1; if d == 0 { break; } }
                        m += 1;
                    }
                    if m < len { i = m + 1; continue; }
                }
            }
        }
        break;
    }
    i - pos
}
ws = Zig {
    var i: usize = pos;
    while (i < len) {
        const c = s[i];
        if (c == 32 or (c >= 9 and c <= 13)) { i += 1; continue; }
        if (c == 47 and i + 1 < len and s[i + 1] == 42) {
            var j: usize = i + 2;
            while (j + 1 < len and !(s[j] == 42 and s[j + 1] == 47)) j += 1;
            if (j + 1 >= len) break;
            i = j + 2;
            continue;
        }
        if (c == 47 and i + 1 < len and s[i + 1] == 47) { while (i < len and s[i] != 10) i += 1; continue; }
        if (c == 35) { while (i < len and s[i] != 10) i += 1; continue; }
        if (c == 91 and i + 1 < len and s[i + 1] == 91) {
            var j: usize = i + 2;
            while (j + 1 < len and !(s[j] == 93 and s[j + 1] == 93)) j += 1;
            if (j + 1 >= len) break;
            i = j + 2;
            continue;
        }
        if (c == 95) {
            var j: usize = i;
            while (j < len and (s[j] == 95 or std.ascii.isAlphanumeric(s[j]))) j += 1;
            const w = s[i..j];
            if (std.mem.eql(u8, w, "__extension__")) { i = j; continue; }
            if (std.mem.eql(u8, w, "__attribute__") or std.mem.eql(u8, w, "__attribute") or std.mem.eql(u8, w, "__asm__") or std.mem.eql(u8, w, "__asm")) {
                var k: usize = j;
                while (k < len and (s[k] == 32 or (s[k] >= 9 and s[k] <= 13))) k += 1;
                if (k < len and s[k] == 40) {
                    var d: usize = 0;
                    var m: usize = k;
                    while (m < len) : (m += 1) {
                        const q = s[m];
                        if (q == 34 or q == 39) {
                            m += 1;
                            while (m < len and s[m] != q) { if (s[m] == 92) m += 1; m += 1; }
                            continue;
                        }
                        if (q == 40) {
                            d += 1;
                        } else if (q == 41) {
                            d -= 1;
                            if (d == 0) break;
                        }
                    }
                    if (m < len) { i = m + 1; continue; }
                }
            }
        }
        break;
    }
    return i - pos;
}
ws = Ada {
      I : Natural := Pos;
      J : Natural;
      K : Natural;
      M : Natural;
      D : Natural;
      Done : Boolean := False;

      function Word_End (From : Natural) return Natural is
         E : Natural := From;
      begin
         while E <= Len and then (S (E) = '_' or else S (E) in 'a' .. 'z' | 'A' .. 'Z' | '0' .. '9') loop
            E := E + 1;
         end loop;
         return E;
      end Word_End;
   begin
      while I <= Len and then not Done loop
         declare
            C : constant Natural := Character'Pos (S (I));
         begin
            if C = 32 or else (C >= 9 and then C <= 13) then
               I := I + 1;
            elsif C = 47 and then I < Len and then Character'Pos (S (I + 1)) = 42 then
               J := I + 2;
               while J < Len and then not (Character'Pos (S (J)) = 42 and then Character'Pos (S (J + 1)) = 47) loop
                  J := J + 1;
               end loop;
               if J >= Len then
                  Done := True;
               else
                  I := J + 2;
               end if;
            elsif C = 47 and then I < Len and then Character'Pos (S (I + 1)) = 47 then
               while I <= Len and then Character'Pos (S (I)) /= 10 loop I := I + 1; end loop;
            elsif C = 35 then
               while I <= Len and then Character'Pos (S (I)) /= 10 loop I := I + 1; end loop;
            elsif C = 91 and then I < Len and then Character'Pos (S (I + 1)) = 91 then
               J := I + 2;
               while J < Len and then not (Character'Pos (S (J)) = 93 and then Character'Pos (S (J + 1)) = 93) loop
                  J := J + 1;
               end loop;
               if J >= Len then Done := True; else I := J + 2; end if;
            elsif C = 95 then
               J := Word_End (I);
               if S (I .. J - 1) = "__extension__" then
                  I := J;
               elsif S (I .. J - 1) in "__attribute__" | "__attribute" | "__asm__" | "__asm" then
                  K := J;
                  while K <= Len and then (Character'Pos (S (K)) = 32 or else (Character'Pos (S (K)) >= 9 and then Character'Pos (S (K)) <= 13)) loop
                     K := K + 1;
                  end loop;
                  if K <= Len and then Character'Pos (S (K)) = 40 then
                     D := 0;
                     M := K;
                     while M <= Len loop
                        declare
                           Q : constant Natural := Character'Pos (S (M));
                        begin
                           if Q = 34 or else Q = 39 then
                              M := M + 1;
                              while M <= Len and then Character'Pos (S (M)) /= Q loop
                                 if Character'Pos (S (M)) = 92 then M := M + 1; end if;
                                 M := M + 1;
                              end loop;
                              M := M + 1;
                           else
                              if Q = 40 then
                                 D := D + 1;
                              elsif Q = 41 then
                                 D := D - 1;
                                 exit when D = 0;
                              end if;
                              M := M + 1;
                           end if;
                        end;
                     end loop;
                     if M <= Len then I := M + 1; else Done := True; end if;
                  else
                     Done := True;
                  end if;
               else
                  Done := True;
               end if;
            else
               Done := True;
            end if;
         end;
      end loop;
      return I - Pos;
}
