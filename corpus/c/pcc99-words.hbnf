; The tokens of the C that PCC's compiler reads (cc/ccom/scan.c and cgram.y of the NetBSD trunk) as
; rules of characters: C99's (ISO/IEC 9899:1999 6.4), the keywords of the C11 forms its grammar has,
; and the double-underscore spellings of keywords its GNU subset uses.  Nothing here skips white
; space; pcc99.hbnf, which includes this file, does that between tokens.  Keywords are the literals
; of the grammar, matched whole by `word` (letters, digits and _), which is why this file defines
; `word`: the built-in one also takes - and ., and `return-1` is `return` and `-1`.
prefix none
whitespace none
include "../../grammars/common.hbnf"

BS     = 0x5C
SQUOTE = 0x27

; ---- identifiers ----
; (the letters inside a token are written as code points: a letter-led literal is a whole word)
idstart    = ALPHA | "_" | "$"
idchar     = ALPHA | DIGIT | "_" | "$"
word       = idstart *idchar
any-word   = idstart *idchar   ; a name or a keyword: what an attribute may be called
keyword    = "auto" | "break" | "case" | "char" | "const" | "continue" | "default" | "do" | "double"
           | "else" | "enum" | "extern" | "float" | "for" | "goto" | "if" | "inline" | "int" | "long"
           | "register" | "restrict" | "return" | "short" | "signed" | "sizeof" | "static" | "struct"
           | "switch" | "typedef" | "union" | "unsigned" | "void" | "volatile" | "while"
           | "_Bool" | "_Complex" | "_Imaginary"
           | "_Alignas" | "_Alignof" | "_Atomic" | "_Generic" | "_Noreturn" | "_Static_assert" | "_Thread_local"
           | "asm" | "typeof" | "__alignof" | "__alignof__" | "__asm" | "__asm__" | "__attribute"
           | "__attribute__" | "__builtin_offsetof" | "__builtin_va_list" | "__complex" | "__complex__"
           | "__const" | "__const__" | "__inline" | "__inline__" | "__restrict" | "__restrict__"
           | "__signed" | "__signed__" | "__thread" | "__typeof" | "__typeof__" | "__volatile" | "__volatile__"
identifier = word - keyword

; ---- constants ----
constant   = floating-constant | integer-constant | character-constant
ex         = 0x78 | 0x58
you        = 0x75 | 0x55
ell        = 0x6C | 0x4C
eee        = 0x65 | 0x45
pee        = 0x70 | 0x50
eff        = 0x66 | 0x46
imag       = 0x69 | 0x49 | 0x6A | 0x4A
sign       = 0x2B | 0x2D
digits     = 1*DIGIT
octd       = 0x30..0x37
hexd       = DIGIT | 0x41..0x46 | 0x61..0x66
hexdigits  = 1*hexd
long-suffix = 0x6C 0x6C | 0x4C 0x4C | ell
int-suffix = you [ long-suffix ] [ imag ] | long-suffix [ you ] [ imag ] | imag [ you ] [ long-suffix ]
integer-constant = ( 0x31..0x39 *DIGIT | 0x30 ex hexdigits | 0x30 *octd ) [ int-suffix ]
floating-constant = ( dec-float | hex-float ) [ fsuffix ]
fsuffix    = eff | ell | imag [ eff | ell ] | ( eff | ell ) imag
dec-float  = digits 0x2E *DIGIT [ exponent ] | 0x2E digits [ exponent ] | digits exponent
exponent   = eee [ sign ] digits
hex-float  = 0x30 ex hex-mantissa pee [ sign ] digits
hex-mantissa = hexdigits 0x2E *hexd | hexdigits | 0x2E hexdigits
char-body  = ~( SQUOTE | BS | LF ) | BS ~LF
character-constant = [ 0x4C ] SQUOTE 1*char-body SQUOTE

; ---- string literals ----
str-body   = ~( DQUOTE | BS | LF ) | BS ( LF | ~LF )
string-literal = [ 0x4C ] DQUOTE *str-body DQUOTE

; White space between tokens: blanks, both kinds of comment, and the lines a preprocessor leaves in
; its output (`# 12 "file.c"`, `#pragma`), since hbnf has no preprocessor.  Attributes and asm are
; in the grammar, not here.
blank      = SP | HTAB | LF | CR | 0x0B | 0x0C
comment    = "/*" *( ~"*" | 1*"*" ~( "*" | "/" ) ) 1*"*" "/"
line-comment = "//" *~LF
pp-line    = "#" *( "\\" ( CR LF | LF ) | ~LF )
ws         = 1*( blank | comment | line-comment | pp-line | line-splice )
; a backslash before the end of a line is nothing, wherever it stands (translation phase 2): a macro body that went on over lines leaves them
line-splice = "\\" ( CR LF | LF )
