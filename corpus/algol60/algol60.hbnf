; ALGOL 60 (Revised Report, Naur ed., 1963) in hbnf.
;
; The Report's syntax is in syntax.txt, 108 productions.  This is the same
; language, said the way hbnf says things, and it is not a transliteration:
;   - the Report's lists (<type list>, <array list>, ...) are  x *( "," x );
;   - `begin` ... `end` is one rule: a block is a compound statement with
;     declarations in front, so one rule with `*( declaration ";" )` is both;
;   - arithmetic, Boolean and designational expressions are one expression,
;     since which type a name has is for a checking pass, not for the parser;
;   - the character-level productions (<letter>, <digit>, <identifier>, numbers)
;     are written once, with the RFC core rules.
; Keywords are the Report's word symbols in apostrophes ('BEGIN', 'END'), the
; stropping syntax.txt uses, so nothing is reserved: an identifier is any word.
; The multiplication, division, power and relational signs have ASCII spellings
; (* / 'DIV' 'POWER' ^ < <= = >= > <>) as well as the Report's word forms.
; 'COMMENT' text up to the next ; is white space wherever it stands, the text
; after 'END' up to a ; or a word symbol is skipped (section 2.3), and a string
; is "..." with no quote inside.  Machine-code bodies (<code>) are not read.
prefix none
include "../../grammars/common.hbnf"

program = *( label ":" !"=" ) block

; ---- statements ----------------------------------------------------------
block = "'BEGIN'" *( declaration ";" ) statement *( ";" statement ) "'END'" end-junk
end-junk = *( ~( ";" / "'" ) )

statement = label ":" !"=" statement
          | if-clause ( for-statement | unconditional-statement [ "'ELSE'" statement ] )
          | for-statement
          | unconditional-statement

; a then-branch is an unconditional statement, which settles the dangling else
unconditional-statement = label ":" !"=" unconditional-statement
                        | block
                        | 1*( variable ":=" ) expression       ; a := b := c
                        | "'GOTO'" designational-expression
                        | identifier [ actual-parameters ]    ; a procedure call
                        |                                      ; the dummy statement

if-clause     = "'IF'" expression "'THEN'"
for-statement = "'FOR'" variable ":=" for-element *( "," for-element ) "'DO'" statement
for-element   = expression [ "'STEP'" expression "'UNTIL'" expression
                           | "'WHILE'" expression ]
label = identifier / 1*DIGIT

; ---- expressions ---------------------------------------------------------
; one grammar of precedence, loosest first: EQUIV IMPL OR AND NOT, the
; relations, + -, * / DIV, POWER.  The Report gives the then-part of a
; conditional expression as a simple expression, so no unparenthesised IF
; inside it.
expression  = if-clause equivalence "'ELSE'" expression
            | equivalence
equivalence = implication *( "'EQUIV'" implication )
implication = disjunction *( "'IMPL'" disjunction )
disjunction = conjunction *( "'OR'" conjunction )
conjunction = negation *( "'AND'" negation )
negation    = [ "'NOT'" ] relation
relation    = sum [ relop sum ]
sum         = [ "+" / "-" ] term *( ( "+" / "-" ) term )
term        = factor *( ( "*" / "/" / "'DIV'" ) factor )
factor      = primary *( ( "'POWER'" / "^" ) primary )

primary = number
        | "'TRUE'" | "'FALSE'"
        | "(" expression ")"
        | identifier "[" expressions "]"
        | identifier actual-parameters
        | identifier

relop = "<=" / ">=" / "<>" / "<" / ">" / "="
      / "'NOTGREATER'" / "'NOTLESS'" / "'NOTEQUAL'" / "'LESS'" / "'GREATER'" / "'EQUAL'"

variable          = identifier [ "[" expressions "]" ]
actual-parameters = "(" actual *( "," actual | ")" 1*ALPHA ":" "(" actual ) ")"
actual            = string / expression

; a goto, and a switch, take a designational expression
designational-expression = if-clause designator "'ELSE'" designational-expression
                         | designator
designator = identifier "[" expression "]"
           | "(" designational-expression ")"
           | label

; ---- declarations --------------------------------------------------------
declaration = [ "'OWN'" ] [ type ] "'ARRAY'" array-segment *( "," array-segment )
            | "'SWITCH'" identifier ":=" designational-expression *( "," designational-expression )
            | [ type ] "'PROCEDURE'" identifier [ formals ] ";"
                [ "'VALUE'" identifiers ";" ]
                *( specifier identifiers ";" ) statement
            | [ "'OWN'" ] type identifiers

type      = "'REAL'" / "'INTEGER'" / "'BOOLEAN'"
specifier = "'STRING'" / "'LABEL'" / "'SWITCH'"
          / [ type ] ( "'ARRAY'" / "'PROCEDURE'" ) / type
array-segment = identifiers "[" bound *( "," bound ) "]"
bound         = expression ":" expression
identifiers   = identifier *( "," identifier )
expressions   = expression *( "," expression )
formals = "(" identifier *( "," identifier | ")" 1*ALPHA ":" "(" identifier ) ")"

; ---- the characters ------------------------------------------------------
identifier = ALPHA *( ALPHA / DIGIT )
number     = ( 1*DIGIT [ "." 1*DIGIT ] / "." 1*DIGIT ) [ "E" [ "+" / "-" ] 1*DIGIT ]
string     = DQUOTE *( ~DQUOTE ) DQUOTE

ws = *( SP / HTAB / CR / LF / "'COMMENT'" *( ~";" ) ";" )
