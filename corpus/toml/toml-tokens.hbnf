; The tokens of TOML 1.0: strings, numbers, dates and bare keys.  No blank is allowed inside
; one, so this file skips none (`whitespace none`).  The four strings are two shapes, one line
; (`line`) and many (`lines`), each given its quote and its characters.
whitespace none
prefix none
include "../../grammars/common.hbnf"

dq  = DQUOTE
sq  = "'"
non-ascii = 0x80..0xD7FF / 0xE000..0x10FFFF
hidden newline = LF / CRLF

string  = lines(dq, basic-char, mlb-extra) / lines(sq, literal-char, mll-extra) / quoted-key
quoted-key = line(dq, basic-char) / line(sq, literal-char)
line(Q, C)      := Q *C Q
lines(Q, C, X)  := Q Q Q [ newline ] *( C / newline / X ) *( 1*2Q 1*( C / newline / X ) ) [ 1*2Q ] Q Q Q

basic-char    = 0x09 / 0x20..0x21 / 0x23..0x5B / 0x5D..0x7E / non-ascii / 0x5C escape
escape        = 0x22 / 0x5C / "b" / "f" / "n" / "r" / "t" / "u" scalar4
              / "U" ( "0000" scalar4 / "000" nonzero 4HEXDIG / "0010" 4HEXDIG )
scalar4       = ( DIGIT / 0x41..0x43 / 0x45..0x46 / 0x61..0x63 / 0x65..0x66 ) 3HEXDIG / ( "D" / "d" ) 0x30..0x37 2HEXDIG   ; not a surrogate
nonzero       = 0x31..0x39 / 0x41..0x46 / 0x61..0x66
mlb-extra     = 0x5C *WSP newline *( WSP / newline )   ; a line-ending backslash
literal-char  = 0x09 / 0x20..0x26 / 0x28..0x7E / non-ascii
mll-extra     = 0x0D                                   ; never: a CR needs its LF
bare-key      = 1*( ALNUM / "-" / "_" )
comment       = "#" *( 0x09 / 0x20..0x7E / non-ascii )

boolean   = "true" / "false"
OCT       = 0x30..0x37
sign      = "+" / "-"
digits(D) := D *( D / "_" D )
integer   = "0x" digits(HEXDIG) / "0o" digits(OCT) / "0b" digits(BIT)
          / [ sign ] ( DIGIT / 0x31..0x39 *( DIGIT / "_" DIGIT ) )
real     = [ sign ] ( "inf" / "nan" )
          / integer-part ( exp / "." digits(DIGIT) [ exp ] )
integer-part = [ sign ] ( DIGIT / 0x31..0x39 *( DIGIT / "_" DIGIT ) )
exp       = ( "e" / "E" ) [ sign ] digits(DIGIT)

date-time = full-date [ ( "T" / "t" / SP ) partial-time [ offset ] ] / partial-time
full-date = ( leap-year "-02-29" / 4DIGIT "-" ( ( "04" / "06" / "09" / "11" ) "-" ( "30" / day ) / "02" "-" ( "0" 0x31..0x39 / "1" DIGIT / "2" 0x30..0x38 ) / month "-" ( "3" ( "0" / "1" ) / day ) ) )
leap-year = by4 "00" / 2DIGIT tail4
by4       = ( "0" / "2" / "4" / "6" / "8" ) ( "0" / "4" / "8" ) / ( "1" / "3" / "5" / "7" / "9" ) ( "2" / "6" )   ; 00 .. 96
tail4     = "0" ( "4" / "8" ) / ( "2" / "4" / "6" / "8" ) ( "0" / "4" / "8" ) / ( "1" / "3" / "5" / "7" / "9" ) ( "2" / "6" )   ; 04 .. 96
day       = "0" 0x31..0x39 / 0x31..0x32 DIGIT
month     = "0" ( "1" / "3" / "5" / "7" / "8" ) / "1" ( "0" / "2" )
partial-time = hour ":" minute ":" ( minute / "60" ) [ "." 1*DIGIT ]
hour      = 0x30..0x31 DIGIT / "2" 0x30..0x33
minute    = 0x30..0x35 DIGIT
offset    = "Z" / "z" / sign hour ":" minute
