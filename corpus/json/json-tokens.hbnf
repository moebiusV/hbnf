; The tokens of JSON (RFC 8259 sections 6 and 7): a number and a string.  No blank
; is allowed inside either, so this file skips none (`whitespace none`), and every
; rule of it that is only text is one token, a string, scanned by an automaton.
; Letters in an escape are written by code (%x62), as in the RFC.  (`int` would be hbnf's own
; built-in number, so the integer part is called `integer`.)
whitespace none
prefix none
include "../../grammars/common.hbnf"

string    = DQUOTE *char DQUOTE
char      = unescaped / 0x5C escape
unescaped = 0x20..0x21 / 0x23..0x5B / 0x5D..0x10FFFF
escape    = 0x22 / 0x5C / 0x2F / 0x62 / 0x66 / 0x6E / 0x72 / 0x74 / 0x75 4HEXDIG

number    = [ "-" ] integer [ frac ] [ exp ]
integer   = "0" / 0x31..0x39 *DIGIT
frac      = "." 1*DIGIT
exp       = ( 0x65 / 0x45 ) [ "+" / "-" ] 1*DIGIT

; The three literals are tokens of their own, so the tree says which one was read
; (a quoted "true" in json.hbnf would leave no field and all three would look alike).
literal-true  = "true"
literal-false = "false"
literal-null  = "null"
