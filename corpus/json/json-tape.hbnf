; JSON (RFC 8259) read into a flat tape of 64-bit words, with no tree: the same language as
; json.hbnf, with an %emit where the tree would have made a node.  An object or an array is
; opened where its bracket is read and closed where its bracket ends, a value is one tag and its
; text; `$$` of the object or array is where it begins on the tape, kept for the closing emit.
prefix none
{
#include <stdint.h>
#include <stdlib.h>
#include <sys/mman.h>

/* The tape: one 64-bit word for each value and each key.  The top byte is the tag.  A string,
   number or key holds the length of its text (16 bits) and where it starts in the input (40 bits);
   a text of 65535 bytes or more says 65535 there and has its length in the word after.  An object
   or array holds the tape position after it (so a reader can skip it); a literal holds nothing. */
enum { T_OBJ = 1, T_ARR, T_STR, T_NUM, T_TRUE, T_FALSE, T_NULL, T_KEY };
#define TAPE_TAG(t) ((uint64_t) (t) << 56)
#define TAPE_LONG 0xFFFFu
static uint64_t *tape;
static size_t tape_n, tape_cap;

/* A tape that outgrows its room doubles; this is the way out of the fast path, not the usual one. */
static __attribute__((noinline)) void tape_grow (void)
{
    size_t cap = tape_cap ? tape_cap * 2 : 1 << 16;
    uint64_t *t = realloc (tape, cap * sizeof *tape);
    if (!t) abort ();
    tape = t;
    tape_cap = cap;
}

/* Room for a document of this many bytes, before the parse: an eighth of a word a byte is more
   than the usual document needs.  The room starts on a 2 MiB boundary and asks for huge pages, so
   filling it costs a few page faults, not one for every 4 KiB. */
static void tape_reserve (size_t input_bytes)
{
    const size_t huge = (size_t) 2 << 20;
    size_t bytes = ((input_bytes / 8 + 64) * sizeof *tape + huge - 1) & ~(huge - 1);
    void *m = aligned_alloc (huge, bytes);
    if (!m) return;
#ifdef MADV_HUGEPAGE
    madvise (m, bytes, MADV_HUGEPAGE);
#endif
    free (tape);
    tape = m;
    tape_cap = bytes / sizeof *tape;
}

static inline void tape_put (uint64_t w)
{
    if (__builtin_expect (tape_n + 1 > tape_cap, 0)) tape_grow ();
    tape[tape_n++] = w;
}

/* A text of n bytes that ends at `end` in the input: the parser's position, just after the token. */
static inline void tape_text_of (uint64_t tag, size_t end, size_t n)
{
    uint64_t start = end - n;
    if (__builtin_expect (n >= TAPE_LONG, 0)) {
        tape_put (TAPE_TAG (tag) | (uint64_t) TAPE_LONG << 40 | start);
        tape_put (n);
    } else {
        tape_put (TAPE_TAG (tag) | (uint64_t) n << 40 | start);
    }
}
static inline uint64_t tape_open (uint64_t tag)
{
    uint64_t at = tape_n;
    tape_put (TAPE_TAG (tag));
    return at;
}
static inline void tape_close (uint64_t at)
{
    tape[at] |= tape_n;
}
}

include "json-tokens.hbnf"

json  :: int = value
value :: int = object | array
             | string %emit{ tape_text_of (T_STR, p->pos, hbnf_sn (string)); }
             | number %emit{ tape_text_of (T_NUM, p->pos, hbnf_sn (number)); }
             | literal-true  %emit{ tape_put (TAPE_TAG (T_TRUE)); }
             | literal-false %emit{ tape_put (TAPE_TAG (T_FALSE)); }
             | literal-null  %emit{ tape_put (TAPE_TAG (T_NULL)); }
object :: uint64_t = "{" %emit{ $$ = tape_open (T_OBJ); } [ member *( "," member ) ] "}" %emit{ tape_close ($$); }
member :: int = string %emit{ tape_text_of (T_KEY, p->pos, hbnf_sn (string)); } ":" value
array  :: uint64_t = "[" %emit{ $$ = tape_open (T_ARR); } [ value *( "," value ) ] "]" %emit{ tape_close ($$); }

ws = *( SP / HTAB / LF / CR )
