; JSON (RFC 8259) read into a flat tape of 64-bit words, with no tree: the same language as
; json.hbnf, with an %emit where the tree would have made a node.  An object or an array is
; opened where its bracket is read and closed where its bracket ends, a value is one tag and its
; text; `$$` of the object or array is where it begins on the tape, kept for the closing emit.
prefix none
{
#include <stdint.h>
#include <stdlib.h>
#include <sys/mman.h>

/* the tape: a tag, then for a string, number or literal the offset and length of its text, for an
   object or array the tape position after it (so a reader can skip it) and the number of members */
enum { T_OBJ = 1, T_ARR, T_STR, T_NUM, T_TRUE, T_FALSE, T_NULL, T_KEY };
static uint64_t *tape;
static size_t tape_n, tape_cap;
static const char *tape_text;

/* A tape that outgrows its room doubles; this is the way out of the fast path, not the usual one. */
static __attribute__((noinline)) void tape_grow (void)
{
    size_t cap = tape_cap ? tape_cap * 2 : 1 << 16;
    uint64_t *t = realloc (tape, cap * sizeof *tape);
    if (!t) abort ();
    tape = t;
    tape_cap = cap;
}

/* Room for a document of this many bytes, before the parse: a quarter word a byte is more than
   the usual document needs.  The room starts on a 2 MiB boundary and asks for huge pages, so
   filling it costs a few page faults, not one for every 4 KiB. */
static void tape_reserve (size_t input_bytes)
{
    const size_t huge = (size_t) 2 << 20;
    size_t bytes = ((input_bytes / 4 + 64) * sizeof *tape + huge - 1) & ~(huge - 1);
    void *m = aligned_alloc (huge, bytes);
    if (!m) return;
#ifdef MADV_HUGEPAGE
    madvise (m, bytes, MADV_HUGEPAGE);
#endif
    free (tape);
    tape = m;
    tape_cap = bytes / sizeof *tape;
}

static inline void tape_put (uint64_t a, uint64_t b)
{
    if (__builtin_expect (tape_n + 2 > tape_cap, 0)) tape_grow ();
    tape[tape_n++] = a;
    tape[tape_n++] = b;
}
static inline uint64_t tape_open (uint64_t tag)
{
    uint64_t at = tape_n;
    tape_put (tag, 0);
    return at;
}
static inline void tape_close (uint64_t at)
{
    tape[at + 1] = tape_n;
}
static inline void tape_text_of (uint64_t tag, const char *s, size_t n)
{
    tape_put (tag, (uint64_t) (s - tape_text) << 24 | n);
}
}

include "json-tokens.hbnf"

json  :: int = value
value :: int = object | array
             | string %emit{ tape_text_of (T_STR, hbnf_sp (string), hbnf_sn (string)); }
             | number %emit{ tape_text_of (T_NUM, hbnf_sp (number), hbnf_sn (number)); }
             | literal-true  %emit{ tape_put (T_TRUE, 0); }
             | literal-false %emit{ tape_put (T_FALSE, 0); }
             | literal-null  %emit{ tape_put (T_NULL, 0); }
object :: uint64_t = "{" %emit{ $$ = tape_open (T_OBJ); } [ member *( "," member ) ] "}" %emit{ tape_close ($$); }
member :: int = string %emit{ tape_text_of (T_KEY, hbnf_sp (string), hbnf_sn (string)); } ":" value
array  :: uint64_t = "[" %emit{ $$ = tape_open (T_ARR); } [ value *( "," value ) ] "]" %emit{ tape_close ($$); }

ws = *( SP / HTAB / LF / CR )
