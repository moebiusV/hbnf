; The characters of YAML 1.2: the pieces in which no blank may be skipped, and which are the
; same wherever they stand.  The structure, which depends on the indentation, is in yaml.hbnf.
whitespace none
prefix none
include "../../grammars/common.hbnf"
hidden SP WSP DQUOTE    ; blanks and the quote marks round a quoted scalar: matched, and kept by nothing

hidden nl = CRLF | LF | CR
any      = 0x00..0x10FFFF
WSP      = SP | HTAB
nonns    = 0x00..0x20 | 0x7F..0x84 | 0x86..0x9F | 0xD800..0xDFFF | 0xFEFF | 0xFFFE..0xFFFF
ns       = ~nonns
nb       = HTAB | 0x20..0x7E | 0x85 | 0xA0..0xD7FF | 0xE000..0xFEFE | 0xFF00..0xFFFD | 0x10000..0x10FFFF
flow-ind = 0x2C | 0x5B | 0x5D | 0x7B | 0x7D
indicator = "-" | "?" | ":" | "," | "[" | "]" | "{" | "}" | "#" | "&" | "*" | "!" | "|" | ">" | "'" | DQUOTE | "%" | "@" | "`"
marker   = ( "---" | "..." ) ( WSP | nl )

hidden trail = 1*WSP "#" *nb | *WSP                  ; the rest of a line
hidden lines = *WSP nl *( *WSP nl )                          ; a line end, and the blank lines after it
hidden flines = nl *( *WSP nl )                           ; the same inside a flow collection, where blanks before it belong to the node
hidden gap = *( *WSP [ "#" *nb ] nl )              ; blank and comment lines

; ---- the properties of a node
uri      = ALNUM | "#" | ";" | "/" | "?" | ":" | "@" | "&" | "=" | "+" | "$" | "_" | "." | "~" | "*" | "'" | "(" | ")" | "-" | "%" HEXDIG HEXDIG
tag      = "!<" 1*( uri | flow-ind | "!" ) ">" | "!" *( uri | "!" )
aname    = 1*~( nonns | flow-ind )
anchor   = "&" aname
alias    = "*" aname
props    = tag [ 1*WSP anchor ] | anchor [ 1*WSP tag ]
props2   = tag 1*WSP anchor | anchor 1*WSP tag

; ---- plain scalars; C is "block" or "flow"
safe(C in "block" | "flow") := ~( nonns | flow-ind )
safe("block") := ns
first(C in "block" | "flow") := ~( nonns | indicator ) | ( "?" | ":" | "-" ) safe(C)
pc(C in "block" | "flow") := ~( nonns | flow-ind | ":" )
pc("block") := ~( nonns | ":" )
pcx(C in "block" | "flow") := ~( nonns | flow-ind | ":" | "#" )
pcx("block") := ~( nonns | ":" | "#" )
plainline(C in "block" | "flow") := first(C) *( pc(C) | ":" safe(C) | 1*WSP ( pcx(C) | ":" safe(C) ) )
ptail(C in "block" | "flow") := *( pc(C) | ":" safe(C) | 1*WSP ( pcx(C) | ":" safe(C) ) )
pcont(C in "block" | "flow") := ( pcx(C) | ":" safe(C) ) ptail(C)

; ---- quoted scalars
esc      = "0" | "a" | "b" | "t" | HTAB | "n" | "v" | "f" | "r" | "e" | SP | DQUOTE | "/" | 0x5C | "N" | "_" | "L" | "P" | "x" 2HEXDIG | "u" 4HEXDIG | "U" 8HEXDIG
dqc      = SP | HTAB | ~( nonns | DQUOTE | 0x5C ) | 0x5C esc
sqc      = SP | HTAB | ~( nonns | "'" ) | "''"
dqs        = 1*dqc
sqs        = 1*sqc
dqline      = DQUOTE *dqc DQUOTE
sqline      = "'" *sqc "'"

dword    = 1*ns
dres     = "YAML" | "TAG"
dname    = dword - dres
chomp    = "+" | "-"
digit19  = 0x31..0x39
