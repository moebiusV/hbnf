; The tokens of COBOL source in free format (ISO/IEC 1989) as rules of characters.  Nothing here skips white
; space; cobol.hbnf, which includes this file, does that between tokens.  COBOL has no case: `sensitivity
; string %i` makes every literal match either case.  A word is letters, digits and hyphens, so `END-IF` is one
; word and `A - B` (with blanks) subtracts where `A-B` is a name; the keywords are the grammar's literals, matched
; whole by `word`, and a reserved word is not a name.
prefix none
whitespace none
sensitivity string %i
include "../../grammars/common.hbnf"
include "reserved.hbnf"

wordchar  = ALNUM | "-" | "_"
word      = ALNUM *wordchar
; a user-defined word has a letter in it (a word of digits and hyphens alone names a paragraph or a section, or is a number)
no-letter = r"[0-9_-]+"
; XML, JSON, ABSENT, EQUALS, PROMPT and LABEL are context words in cobc (not reserved); here they start a statement or a clause, so a list of operands stops at them
not-a-name = reserved-word | no-letter | "XML" | "JSON" | "END-XML" | "END-JSON" | "ABSENT" | "EQUALS" | "PROMPT" | "LABEL" | "ESCAPE" | "ENTRY"
user-word = word - not-a-name

; Blank space between tokens: a space, a tab or a line end; a comma or a semicolon, which COBOL reads as a
; space; and a comment, `*>` to the end of the line, which may follow anything; and a compiler directive, `>>` to the end of the line,
; which is read as a comment (so `>>IF` and `>>END-IF` both take effect, and a program with alternatives in them is read twice).
; A `$` line is a directive (`$SET`, `$IF`) unless picture symbols only follow, up to a character that is no letter: `$BB**,**9` and `$99` are pictures.
picletter     = 0x41 | 0x42 | 0x43 | 0x44 | 0x45 | 0x50 | 0x52 | 0x53 | 0x56 | 0x58 | 0x5A
              | 0x61 | 0x62 | 0x63 | 0x64 | 0x65 | 0x70 | 0x72 | 0x73 | 0x76 | 0x78 | 0x7A
picture-start = *picletter !ALPHA
ws-text = SP | HTAB | CR | LF | "," | ";" | "*>" *~( CR | LF ) | "*CONTROL" *~( CR | LF ) | "*CBL" *~( CR | LF ) | "@OPTIONS" *~( CR | LF ) | ">>" *~( CR | LF ) | "$" !picture-start ALPHA *~( CR | LF )
; free format reads nothing else between tokens; cobol-fixed.hbnf adds the columns of the reference format to ws-text
ws = ws-text

; ---- literals (the standard's 8.3) ----
; (a letter inside a token is a code point or sits in a regular expression: a letter-led literal would be matched as a whole word)
; a comma may be the decimal point (`DECIMAL-POINT IS COMMA`): `19876,1234`.  The standard puts a space after a separator
; comma, so digits-comma-digits is never a list; whether the program declared the clause is a checking pass's business.
numeric-body    = ir"[+-]?(\d+([.,]\d+)?|\.\d+)(E[+-]?\d+)?"
numeric-literal = numeric-body !( ALPHA | "_" | "-" ALPHA )
digits          = r"\d+"
nonnumeric-literal = ir"([XNZBG]X?)?(\"([^\"]|\"\")*\"|'([^']|'')*')"
SQUOTE          = 0x27

; The text of a PICTURE clause is whatever runs to the next blank; a period belongs to it only when more of it
; follows (`PIC 9(5).99` is one string, the period after `PIC 9(5)` is not).
picture-string  = r"\.?[^ \t\r\n.]+(\.[^ \t\r\n.]+)*"
picture-with-period = r"\.?[^ \t\r\n.]+(\.[^ \t\r\n.]+)*\."

; A level number, and the names of procedures, which may be all digits.
level-number    = r"\d{1,2}"
special-level   = "66" | "78" | "88"
plain-level     = level-number - special-level

; The text of an identification paragraph's comment entry: a word, whatever it is made of.
comment-word      = r"[^ \t\r\n]+"

; A word of an I-O-CONTROL entry: it ends before the period that ends the entry.
entry-word        = nonnumeric-literal | r"[^ \t\r\n.]+"

; The name of an intrinsic function: any word, reserved or not (`FUNCTION LENGTH (X)`).
function-name    = ALNUM *wordchar

; the tokens of COPY and REPLACE: the name of a library, an operand of REPLACING (a word, a literal, or pseudo-text between ==
; and ==, whose blanks are kept as they are), as tokens like the others
text-name         = nonnumeric-literal | word
replacing-operand = pseudo-text | nonnumeric-literal | operand-word
pseudo-text       = "==" *( !"==" OCTET ) "=="
operand-word      = 1*~( SP | HTAB | CR | LF | "." )
