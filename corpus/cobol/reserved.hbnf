              | "DELETE" | "DELIMITED" | "DELIMITER" | "DEPENDING" | "DESCENDING" | "DESTINATION" | "DETAIL"
              | "DISPLAY" | "DIVIDE" | "DIVISION" | "DOWN" | "DUPLICATES" | "DYNAMIC" | "EC" | "EDITING"
