; The words COBOL reserves (ISO/IEC 1989: 1985, 2002, 2014 and 2023), generated by tools/cobol_reserved.py from
; GnuCOBOL 3.2's cobc/reserved.c; do not edit.  410 words.  A reserved word is no name, which is how a
; statement list knows where it ends: ELSE, END-IF and the verbs are none of them a data name.
prefix none
whitespace none
sensitivity string %i

reserved-word = "ACCEPT" | "ACCESS" | "ACTIVE-CLASS" | "ADD" | "ADDRESS" | "ADVANCING" | "AFTER" | "ALIGNED"
              | "ALL" | "ALLOCATE" | "ALPHABET" | "ALPHABETIC" | "ALPHABETIC-LOWER" | "ALPHABETIC-UPPER"
              | "ALPHANUMERIC" | "ALPHANUMERIC-EDITED" | "ALSO" | "ALTER" | "ALTERNATE" | "AND" | "ANY"
              | "ANYCASE" | "ARE" | "AREA" | "AREAS" | "AS" | "ASCENDING" | "ASSIGN" | "AT" | "AUTOMATIC"
              | "B-AND" | "B-NOT" | "B-OR" | "B-SHIFT-L" | "B-SHIFT-LC" | "B-SHIFT-R" | "B-SHIFT-RC" | "B-XOR"
              | "BASED" | "BEFORE" | "BINARY" | "BINARY-CHAR" | "BINARY-DOUBLE" | "BINARY-LONG"
              | "BINARY-SHORT" | "BIT" | "BLANK" | "BLOCK" | "BOOLEAN" | "BOTTOM" | "BY" | "CALL" | "CANCEL"
