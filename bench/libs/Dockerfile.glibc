# Library comparison, glibc: Debian with the popular parsers for JSON, TOML and YAML.
FROM debian:stable-slim
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
    build-essential cargo ca-certificates nodejs npm python3 python3-yaml \
    libcjson-dev libjansson-dev libsimdjson-dev rapidjson-dev \
    libtomlplusplus-dev libtoml11-dev libyaml-dev libyaml-cpp-dev libfyaml-dev \
    && rm -rf /var/lib/apt/lists/*
# js-yaml, the YAML parser Node programs use (JSON.parse and Python's tomllib are built in).
RUN mkdir -p /opt/js && cd /opt/js && npm install --silent js-yaml@4.1.0 2>&1 | tail -1
