--  Library project for the astbnf schema engine (ABNF parser, matcher/binder,
--  C and Ada emitters).  Shipped by the hbnf package from the same source
--  tree, but built as its own library (libastbnf.a), distinct from libhbnf.a.
--  Pure Ada, no C dependencies.

library project ASTBNF is

   for Languages use ("Ada");
   for Source_Dirs use (".");
   for Source_Files use
     ("astbnf.ads", "astbnf.adb",
      "astbnf_match.ads", "astbnf_match.adb",
      "astbnf_ada.ads", "astbnf_ada.adb",
      "astbnf_c.ads", "astbnf_c.adb",
      "astbnf_rust.ads", "astbnf_rust.adb",
      "astbnf_zig.ads", "astbnf_zig.adb");
   for Object_Dir use "obj-astbnf";
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib-astbnf";
   for Library_Name use "astbnf";

   --  Scenario variable, so gprinstall emits the installed "library_type :=
   --  static" marker that tells consuming projects this is a static library.
   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("ASTBNF_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      --  -gnatwe is deliberately absent, matching hbnf: brittle when rebuilt
      --  against each new GNAT.
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatVa", "-gnato",
         "-gnaty3abcefhiklmnprt");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Install is
      for Active use "True";
   end Install;

end ASTBNF;
