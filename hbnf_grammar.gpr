--  Library project for the hbnf schema engine (ABNF parser, matcher/binder,
--  C and Ada emitters).  Shipped by the hbnf package from the same source
--  tree, but built as its own library (libhbnf_grammar.a), distinct from
--  libhbnf.a.  Pure Ada, no C dependencies.

library project HBNF_Grammar is

   for Languages use ("Ada");
   for Source_Dirs use (".");
   for Source_Files use
     ("hbnf_grammar.ads", "hbnf_grammar.adb",
      "hbnf_match.ads", "hbnf_match.adb",
      "hbnf_ada.ads", "hbnf_ada.adb",
      "hbnf_c.ads", "hbnf_c.adb",
      "hbnf_rust.ads", "hbnf_rust.adb",
      "hbnf_zig.ads", "hbnf_zig.adb",
      "templates.ads", "templates.adb");
   for Object_Dir use "obj-hbnf";
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib-hbnf";
   for Library_Name use "hbnf_grammar";

   --  Scenario variable, so gprinstall emits the installed "library_type :=
   --  static" marker that tells consuming projects this is a static library.
   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("HBNF_GRAMMAR_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      --  -gnatwe is deliberately absent, matching hbnf: brittle when rebuilt
      --  against each new GNAT.
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatVa", "-gnato",
         "-gnaty3abcefhiklmnprt");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Install is
      for Active use "True";
   end Install;

end HBNF_Grammar;
