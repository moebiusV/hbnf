   Put_Line ("");
   Emit_Constant ("Ada_Scalar", Read_File ("templates/ada_scalar.tmpl"));
   Put_Line ("");
   Emit_Constant ("Ada_Enum", Read_File ("templates/ada_enum.tmpl"));
   Put_Line ("");
   Emit_Constant ("Ada_Struct", Read_File ("templates/ada_struct.tmpl"));
   Put_Line ("");
