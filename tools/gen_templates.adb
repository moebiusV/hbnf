   Put_Line ("");
   Emit_Constant ("Ada_Parser_Spec", Read_File ("templates/ada_parser_spec.tmpl"));
   Put_Line ("");
   Emit_Constant ("Ada_Parser_Body", Read_File ("templates/ada_parser_body.tmpl"));
   Put_Line ("");
   Put_Line ("   --  Replace every occurrence of From in Text with To.");
   Put_Line ("   function Substitute (Text, From, To : String) return String;");
   Put_Line ("");
   Put_Line ("   Template_Error : exception;");
   Put_Line ("   --  A ${name} hole has no value, a `$` is not `$$`/`${name}`, or a");
   Put_Line ("   --  binding is set twice.");
   Put_Line ("");
   Put_Line ("   type Bindings is private;");
   Put_Line ("   --  ${name} bindings for Render.  Set adds one; Render fills holes");
   Put_Line ("   --  and marks each used; Unused names the first no hole used.");
   Put_Line ("");
   Put_Line ("   procedure Set (B : in out Bindings; Name, Value : String);");
   Put_Line ("");
   Put_Line ("   function Render (Text : String; B : in out Bindings) return String;");
   Put_Line ("");
   Put_Line ("   function Unused (B : Bindings) return String;");
   Put_Line ("");
   Put_Line ("private");
   Put_Line ("");
   Put_Line ("   type Slot is record");
   Put_Line ("      Name  : Ada.Strings.Unbounded.Unbounded_String;");
   Put_Line ("      Value : Ada.Strings.Unbounded.Unbounded_String;");
   Put_Line ("      Used  : Boolean := False;");
   Put_Line ("   end record;");
   Put_Line ("");
   Put_Line ("   package Slot_Vectors is new Ada.Containers.Vectors (Positive, Slot);");
   Put_Line ("");
   Put_Line ("   type Bindings is record");
   Put_Line ("      Slots : Slot_Vectors.Vector;");
   Put_Line ("   end record;");
   Put_Line ("");
   Put_Line ("end Templates;");
end Gen_Templates;
