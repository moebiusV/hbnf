--  libhbnf: the ABNF schema engine (the grammar reader, the compilability
--  checks and the C/Rust/Zig/Ada emitters) in one static library, libhbnf.a.
--  The `hbnf` command line (hbnf.gpr) is a thin wrapper over it.  Pure Ada, no
--  C dependencies.
--  Built and gprinstalled as a static library by the ada-on-alpine aport.
--
--  The code templates are Mustache, rendered by HBNF_Template over the parser hbnf
--  makes of grammars/template.hbnf (kept in the tree, hbnf_template_syntax*).  Nothing
--  is needed beyond the GNAT runtime, so there is no C dependency.

library project Libhbnf is

   for Languages use ("Ada");
   for Source_Dirs use (".");
   for Source_Files use
     ("hbnf_grammar.ads", "hbnf_grammar.adb",
      "hbnf_compilable.ads", "hbnf_compilable.adb",
      "hbnf_c.ads", "hbnf_c.adb",
      "hbnf_rust.ads", "hbnf_rust.adb",
      "hbnf_zig.ads", "hbnf_zig.adb",
      "hbnf_ada.ads", "hbnf_ada.adb",
      "hbnf_wire.ads", "hbnf_wire.adb",
      "hbnf_wire-c.ads", "hbnf_wire-c.adb",
      "hbnf_wire-lower.ads", "hbnf_wire-lower.adb",
      "hbnf_wire-rust.ads", "hbnf_wire-rust.adb",
      "hbnf_wire-zig.ads", "hbnf_wire-zig.adb",
      "hbnf_wire-ada_lang.ads", "hbnf_wire-ada_lang.adb",
      "hbnf_lookahead.ads", "hbnf_lookahead.adb",
      "hbnf_shape.ads", "hbnf_shape.adb",
      "hbnf_tree_sitter.ads", "hbnf_tree_sitter.adb",
      "hbnf_template.ads", "hbnf_template.adb",
      "hbnf_template_syntax.ads", "hbnf_template_syntax-parser.ads", "hbnf_template_syntax-parser.adb");
   for Object_Dir use "obj-hbnf";
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib-hbnf";
   for Library_Name use "hbnf";

   --  Scenario variable, so gprinstall emits the installed "library_type :=
   --  static" marker that tells consuming projects this is a static library
   --  (without it gprbuild defaults to relocatable and forces -lgnat-15).
   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("HBNF_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      --  -gnatwe (warnings-as-errors) is deliberately absent: it is right for
      --  development but brittle in a package rebuilt against each new GNAT.
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatVa", "-gnato",
         "-gnaty3abcefhiklmnprt");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Install is
      for Active use "True";
   end Install;

end Libhbnf;
