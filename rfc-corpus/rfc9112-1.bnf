; RFC 9112, "request-line" (section 3) and the rules it uses, verbatim.  The first
; group is RFC 9112's own, in its order; the second is what it takes from RFC
; 9110 (`token`, `tchar`, `absolute-path`, `uri-host`, `port`); the rest it takes
; from RFC 3986, by the include.  Only the RFC's page headers and footers are
; removed, and the left margin its rules are indented by.  See README.md in this
; directory.

include "rfc3986-1.bnf"

; ---- RFC 9112, section 3 and 2.3 ----
HTTP-version  = HTTP-name "/" DIGIT "." DIGIT

HTTP-name     = %s"HTTP"

request-line   = method SP request-target SP HTTP-version

method         = token

request-target = origin-form
               / absolute-form
               / authority-form
               / asterisk-form

origin-form    = absolute-path [ "?" query ]

absolute-form  = absolute-URI

authority-form = uri-host ":" port

asterisk-form  = "*"

; ---- RFC 9110, as RFC 9112 imports them ----
uri-host      = <host, see [URI], Section 3.2.2>

port          = <port, see [URI], Section 3.2.3>

absolute-path = 1*( "/" segment )

token          = 1*tchar

tchar          = "!" / "#" / "$" / "%" / "&" / "'" / "*"
               / "+" / "-" / "." / "^" / "_" / "`" / "|" / "~"
               / DIGIT / ALPHA
               ; any VCHAR, except delimiters

