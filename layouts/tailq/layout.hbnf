; layout tailq: the tree, with its lists the daemons' own <sys/queue.h> TAILQs.
; Read for `layout tailq` (a directive in a grammar, or --layout=tailq), as an include is: the layout_ops
; block overrides hbnf's built-in singly-linked list with the TAILQ_* macros, and the prologue includes
; the header that defines them.  A grammar may change an operation by saying its own layout_ops.  The file
; has no `language` line, so its code is C, and only the C backend emits it.
{
#include <sys/queue.h>
}

layout_ops {
  head { TAILQ_HEAD(@name@, @elem@) }
  entry { TAILQ_ENTRY(@elem@) _link }
  init { TAILQ_INIT(@h@); }
  append { TAILQ_INSERT_TAIL(@h@, @e@, _link); }
  foreach { TAILQ_FOREACH(@v@, @h@, _link) }
  first { TAILQ_FIRST(@h@) }
  next { TAILQ_NEXT(@e@, _link) }
  relink { if (TAILQ_EMPTY(@h@)) TAILQ_INIT(@h@); else TAILQ_FIRST(@h@)->_link.tqe_prev = &TAILQ_FIRST(@h@); }
}
