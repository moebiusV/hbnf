       | leaf-CMPC16-a-1 | leaf-CBZ1-7-a-1 | leaf-SOX6-a-1 | leaf-SOX6-a-2 | leaf-CBI4-10-c-1 | leaf-CMX2-a-1 | leaf-LDI18-a-1 | leaf-CBZ2-14-a-1
       | leaf-CB3I8-20-c-1 | leaf-CBI4-10-b-1 | leaf-ST0-a-1 | leaf-BR1-6-c-1 | leaf-BR1-6-c-2 | leaf-LDBs8-b-1 | leaf-CMS12-a-1 | leaf-LDX4-b-1
       | leaf-CBI6-12-a-1 | leaf-LDPC12-d-1 | leaf-LDPC12-d-2 | leaf-LDBs14-a-1 | leaf-LDPC14-b-1 | leaf-STSP4-b-1 | leaf-BR1-7-b-1 | leaf-CMBu12-a-1
       | leaf-SPADJ8-a-1 | leaf-CBI10-8-c-1 | leaf-STBs10-a-1 | leaf-IMM3-c-1 | leaf-LDHRH2-a-1 | leaf-LDI14-c-1 | leaf-LDSP7-a-1 | leaf-LDX8-a-1
       | leaf-LDHHR2-a-1 | leaf-CBI6-10-c-1 | leaf-SOBs12-a-1 | leaf-SOBs12-a-2 | leaf-STHHH2-b-1 | leaf-LDBs8-d-1 | leaf-LDBs8-d-2 | leaf-SOX6-x-1
       | leaf-CMBs10-a-1 | leaf-LEAS14-a-1 | leaf-STBs10-b-1 )

encoding-name = "pdp64/16"

; ---- the registers
regs = "r0"@0 | "r1"@1 | "r2"@2 | "r3"@3 | "r4"@4 | "r5"@5 | "r6"@6 | "r7"@7 | "r8"@8 | "r9"@9 | "r10"@10 | "r11"@11 | "r12"@12 | "r13"@13 | "r14"@14
     | "r15"@15
; A register field of W bits that cannot hold a register number is an index into the table hotW (the part of the ABI the encoding depends on, docs/abi.md).
hot3 = "r0" | "r1" | "r8" | "r2" | "sp" | "r3" | "r9" | "r10"

; ---- the fused instructions (the assembler never fuses: they are ordinary mnemonics with operands, chosen by the compiler)
fused = "movcall" | "popmret" | "popret" | "mov2"

; ---- the catalogue of forms: the number is the index of the form (the assembler tries the forms of a mnemonic, shorter first, in this order)
forms = "SYS0"@0 | "SYSR"@1 | "SETF"@2 | "SYSI"@3 | "MFSR"@4 | "MTSR"@5 | "R2"@6 | "R3"@7 | "R4"@8 | "RRI"@9 | "BFx"@10 | "BFy"@11 | "MOVQL"@12
      | "LDU.B28"@13 | "STU.B28"@14 | "LDU.B12"@15 | "STU.B12"@16 | "LDU.X6"@17 | "STU.X6"@18 | "LDF.B28"@19 | "LDF.X22"@20 | "LDF.PI12"@21
      | "LDF.PD12"@22 | "LDF.PC32"@23 | "LDF.A32"@24 | "LDFI.I32"@25 | "STF.B28"@26 | "STF.X22"@27 | "STF.PI12"@28 | "STF.PD12"@29 | "STF.PC32"@30
      | "STF.A32"@31 | "CMF.B28"@32 | "CMF.X22"@33 | "CMF.PI12"@34 | "CMF.PD12"@35 | "CMF.PC32"@36 | "CMF.A32"@37 | "CMF.I32"@38 | "SOF.B28"@39
      | "SOF.X22"@40 | "SOF.PI12"@41 | "SOF.PD12"@42 | "SOF.PC32"@43 | "SOF.A32"@44 | "DPF.D28"@45 | "BRF"@46 | "CALLF"@47 | "PUSHMF"@48 | "SOPR"@49
      | "PUSHI3"@50 | "PUSHI2"@51 | "JTAG3"@52 | "JTAG2"@53 | "RRF"@54 | "CBDI"@55 | "CBDR"@56 | "SOB"@57 | "TAG"@58 | "SPADJF"@59 | "FX.MOVCALL3"@60
      | "FX.MOVCALL2"@61 | "FX.POPMRET"@62 | "FX.POPRET"@63 | "FX.MOV2"@64 | "BR2_16/a"@65 | "LDI12/a"@66 | "STBs8/a"@67 | "CB3I16_12/a"@68
      | "CALL2_16/c"@69 | "CB3I16_12/b"@70 | "LDI12/b"@71 | "CBR8/a"@72 | "PUSHM16a/a"@73 | "STBu8/b"@74 | "LDI12/d"@75 | "BR2_16/b"@76
      | "LEASx12/a"@77 | "LDPC12/a"@78 | "LDBu8/b"@79 | "CMBu8/a"@80 | "CALL2_18/c"@81 | "CBR8/c"@82 | "BR1_6/a"@83 | "CALL2_16/j"@84
      | "CB3I16_12/c"@85 | "CBZ2_12/a"@86 | "LDBs8/a"@87 | "LDBu8/c"@88 | "CBI5_8/a"@89 | "LDPC14/a"@90 | "LDI14/a"@91 | "SOBu12/a"@92 | "STX2/b"@93
      | "CBR8/b"@94 | "STX2/a"@95 | "CBI8_8/b"@96 | "SOBu12/x"@97 | "LDI16/a"@98 | "IMM3/a"@99 | "CBI6_8/a"@100 | "CBI10_8/a"@101 | "LDI12/c"@102
      | "LDX2/b"@103 | "BR2_16/c"@104 | "LDPC16/a"@105 | "LDBu10/a"@106 | "CB3I8_20/a"@107 | "SPADJ6/a"@108 | "LDHHH1/a"@109 | "CBI4_8/c"@110
      | "STHHH1/a"@111 | "STBu10/a"@112 | "LEASP4/a"@113 | "BR1_8/a"@114 | "CMI12/a"@115 | "LDSP4/a"@116 | "CBZ1_4/a"@117 | "BR1_6/b"@118
      | "CBI6_8/c"@119 | "STSP4/a"@120 | "CBI5_10/a"@121 | "CBZ2_12/b"@122 | "LDI14/b"@123 | "CB3R24/a"@124 | "CB3R24/c"@125 | "STBs8/b"@126
      | "SHI3/a"@127 | "LDBu12/a"@128 | "PUSHM8/a"@129 | "IMM5/a"@130 | "STBu10/b"@131 | "CMBu10/a"@132 | "LDX2/c"@133 | "LDHHH3/a"@134 | "IMM3/b"@135
      | "STHHH1/b"@136 | "LDX6/a"@137 | "LDS12/c"@138 | "LDI18/b"@139 | "IMM7/a"@140 | "CBZ1_5/a"@141 | "STBu12/a"@142 | "CBI8_10/a"@143
      | "STX6/a"@144 | "CBR10/c"@145 | "STBu12/b"@146 | "LDBu10/b"@147 | "LDBs10/a"@148 | "CBI8_8/c"@149 | "SHI5/a"@150 | "LDPC16/c"@151
      | "BR1_9/a"@152 | "LDSP5/a"@153 | "STHHH3/a"@154 | "LEAS12/a"@155 | "CBR10/a"@156 | "LDHHH1/b"@157 | "LDBs10/c"@158 | "LDBu12/b"@159
      | "LD0/a"@160 | "CB3I8_20/b"@161 | "STX6/b"@162 | "IMM4/b"@163 | "LDPC12/b"@164 | "CB3R24/b"@165 | "STSP5/a"@166 | "CBI4_12/a"@167
      | "LEASP6/a"@168 | "CMI18/a"@169 | "CMPC16/a"@170 | "CBZ1_7/a"@171 | "SOX6/a"@172 | "CBI4_10/c"@173 | "CMX2/a"@174 | "LDI18/a"@175
      | "CBZ2_14/a"@176 | "CB3I8_20/c"@177 | "CBI4_10/b"@178 | "ST0/a"@179 | "BR1_6/c"@180 | "LDBs8/b"@181 | "CMS12/a"@182 | "LDX4/b"@183
      | "CBI6_12/a"@184 | "LDPC12/d"@185 | "LDBs14/a"@186 | "LDPC14/b"@187 | "STSP4/b"@188 | "BR1_7/b"@189 | "CMBu12/a"@190 | "SPADJ8/a"@191
      | "CBI10_8/c"@192 | "STBs10/a"@193 | "IMM3/c"@194 | "LDHRH2/a"@195 | "LDI14/c"@196 | "LDSP7/a"@197 | "LDX8/a"@198 | "LDHHR2/a"@199
