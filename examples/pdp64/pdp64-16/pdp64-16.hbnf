; ======================================================================================================================================================
; family SYS: 1 form, 2 leaves, 1 parcel; mnemonics nop rti rtt ret halt bpt ...
; ======================================================================================================================================================

; form SYS0 (index 0): 1 parcel
form-SYS0 = noop
leaf-SYS0-1 = 0b11101100100 %prefix sub:5 %sub("sub" "nop rti rtt ret halt bpt fence wfe sev lpad tlbia tlbsync icinva pushx popx isync trapcc.ne trapcc.eq trapcc.pl trapcc.mi trapcc.vc trapcc.vs trapcc.cc trapcc.cs trapcc.ge trapcc.lt trapcc.gt trapcc.le trapcc.hi trapcc.los syspg0 syspg1") %title("SYS0-1: nop rti rtt ret ...")
sub-SYS0-1 = "nop" | "rti" | "rtt" | "ret" | "halt" | "bpt" | "fence" | "wfe" | "sev" | "lpad" | "tlbia" | "tlbsync" | "icinva" | "pushx" | "popx"
     | "isync" | "trapcc.ne" | "trapcc.eq" | "trapcc.pl" | "trapcc.mi" | "trapcc.vc" | "trapcc.vs" | "trapcc.cc" | "trapcc.cs" | "trapcc.ge"
     | "trapcc.lt" | "trapcc.gt" | "trapcc.le" | "trapcc.hi" | "trapcc.los" | "syspg0" | "syspg1"
leaf-SYS0-2 = 0b11110010010110 %prefix sub:2 %sub("sub" "syspg2 syspg3 syspg4 syspg5") %title("SYS0-2: syspg2 syspg3 syspg4 syspg5")
sub-SYS0-2 = "syspg2" | "syspg3" | "syspg4" | "syspg5"

; ======================================================================================================================================================
; family SYSR: 1 form, 2 leaves, 1 parcel; mnemonics mtps mfps tlbi mtasid mfasid mtdp ...
; ======================================================================================================================================================

; form SYSR (index 1): 1 parcel
form-SYSR = o1:reg4
leaf-SYSR-1 = 0b110110100 %prefix sub:3 %sub("sub" "mtps mfps tlbi mtasid mfasid mtdp mfdp mtdmw") o1-r:4 %reg("r1") %title("SYSR-1: mtps mfps tlbi mtasid ...")
sub-SYSR-1 = "mtps" | "mfps" | "tlbi" | "mtasid" | "mfasid" | "mtdp" | "mfdp" | "mtdmw"
leaf-SYSR-2 = 0b11101100101 %prefix sub:1 %sub("sub" "mfcpuid icinv") o1-r:4 %reg("r1") %title("SYSR-2: mfcpuid icinv")
sub-SYSR-2 = "mfcpuid" | "icinv"

; ======================================================================================================================================================
; family SETF: 1 form, 1 leaves, 2 parcels; mnemonics set
; ======================================================================================================================================================

; form SETF (index 2): 2 parcels
form-SETF = o1:imm4u o2:reg4
leaf-SETF-1 = 0b111011110110 %prefix o2-r:4 %reg("r2") o1-imm:4 %imm("imm1") xsub:12 %sub("xsub" "set") ?(xsub < 1) %title("SETF-1: set")
sub-SETF-1 = "set"

; ======================================================================================================================================================
; family SYSI: 1 form, 1 leaves, 1 parcel; mnemonics spl trap trapl hint
; ======================================================================================================================================================

; form SYSI (index 3): 1 parcel
form-SYSI = o1:imm8u
leaf-SYSI-1 = 0b100010 %prefix sub:2 %sub("sub" "spl trap trapl hint") o1-imm:8 %imm("imm1") %title("SYSI-1: spl trap trapl hint")
sub-SYSI-1 = "spl" | "trap" | "trapl" | "hint"

; ======================================================================================================================================================
; family MFSR: 1 form, 1 leaves, 2 parcels; mnemonics mfsr
; ======================================================================================================================================================

; form MFSR (index 4): 2 parcels
form-MFSR = o1:reg4 o2:imm12u
leaf-MFSR-1 = 0b1111001100011100 %prefix o1-r:4 %reg("r1") o2-imm:12 %imm("imm2") %title("MFSR-1: mfsr")
sub-MFSR-1 = "mfsr"

; ======================================================================================================================================================
; family MTSR: 1 form, 1 leaves, 2 parcels; mnemonics mtsr
; ======================================================================================================================================================

; form MTSR (index 5): 2 parcels
form-MTSR = o1:imm12u o2:reg4
leaf-MTSR-1 = 0b1111001100011101 %prefix o2-r:4 %reg("r2") o1-imm:12 %imm("imm1") %title("MTSR-1: mtsr")
sub-MTSR-1 = "mtsr"

; ======================================================================================================================================================
; family R: 3 forms, 3 leaves, 2 parcels; mnemonics clz ctz clo cto popcnt bswap ...
; ======================================================================================================================================================

; form R2 (index 6): 2 parcels
form-R2 = o1:reg4 o2:reg4
leaf-R2-1 = 0b111011110111 %prefix o2-r:4 %reg("r2") o1-r:4 %reg("r1") xsub:12 %sub("xsub" "clz ctz clo cto popcnt bswap bswapw bswapl bitrev utf8len utf8dec utf8enc mval abs prober probew fdiv fsqrt fadd32 fsub32 fmul32 fdiv32 fsqrt32 fcmp32 fneg fabs fclass fclass32 frint frintz frintm frintp frinta fcvtdq fcvtqd fcvtds fcvtsd fcvtsl fcvtls fcvtdqu fcvtqud fsflags fadd16 fsub16 fmul16 fdiv16 fsqrt16 fcmp16 fclass16 fcvtsh fcvths fcvtdh fcvthd fcvthl fcvtlh aesim sha256sig0 sha256sig1 sha256sum0 sha256sum1 sha512sig0 sha512sig1 sha512sum0 sha512sum1 addv subv mulv") ?(xsub < 67) %title("R2-1: clz ctz clo cto ...")
sub-R2-1 = "clz" | "ctz" | "clo" | "cto" | "popcnt" | "bswap" | "bswapw" | "bswapl" | "bitrev" | "utf8len" | "utf8dec" | "utf8enc" | "mval" | "abs"
     | "prober" | "probew" | "fdiv" | "fsqrt" | "fadd32" | "fsub32" | "fmul32" | "fdiv32" | "fsqrt32" | "fcmp32" | "fneg" | "fabs" | "fclass"
     | "fclass32" | "frint" | "frintz" | "frintm" | "frintp" | "frinta" | "fcvtdq" | "fcvtqd" | "fcvtds" | "fcvtsd" | "fcvtsl" | "fcvtls" | "fcvtdqu"
     | "fcvtqud" | "fsflags" | "fadd16" | "fsub16" | "fmul16" | "fdiv16" | "fsqrt16" | "fcmp16" | "fclass16" | "fcvtsh" | "fcvths" | "fcvtdh"
     | "fcvthd" | "fcvthl" | "fcvtlh" | "aesim" | "sha256sig0" | "sha256sig1" | "sha256sum0" | "sha256sum1" | "sha512sig0" | "sha512sig1"
     | "sha512sum0" | "sha512sum1" | "addv" | "subv" | "mulv"

; form R3 (index 7): 2 parcels
form-R3 = o1:reg4 o2:reg4 o3:reg4
leaf-R3-1 = 0b111011111000 %prefix o3-r:4 %reg("r3") o1-r:4 %reg("r1") o2-r:4 %reg("r2") xsub:8 %sub("xsub" "ror xnorpop clmull clmulh mcpy mmov mset mcmp mscn mscnn div divu mod modu mulhu min minu max maxu fcopysign fmin fmax maskeqz masknez aeses aesesm aesds aesdsm aesks2 xadd xadddb swap swapdb xand xanddb xor_ xor_db xxor xxordb xmax xmaxdb xmin xmindb xmaxu xmaxudb xminu xminudb ll sc msha256 msha512") ?(xsub < 51) %title("R3-1: ror xnorpop clmull clmulh ...")
sub-R3-1 = "ror" | "xnorpop" | "clmull" | "clmulh" | "mcpy" | "mmov" | "mset" | "mcmp" | "mscn" | "mscnn" | "div" | "divu" | "mod" | "modu" | "mulhu"
     | "min" | "minu" | "max" | "maxu" | "fcopysign" | "fmin" | "fmax" | "maskeqz" | "masknez" | "aeses" | "aesesm" | "aesds" | "aesdsm" | "aesks2"
     | "xadd" | "xadddb" | "swap" | "swapdb" | "xand" | "xanddb" | "xor_" | "xor_db" | "xxor" | "xxordb" | "xmax" | "xmaxdb" | "xmin" | "xmindb"
