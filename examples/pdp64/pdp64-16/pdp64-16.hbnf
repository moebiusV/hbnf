; Everything the codec, the assembler, the linker, the simulator and the documentation know of this encoding is generated from this file.

prefix none
include "../pdp64-enc.hbnf"

; The instruction: one leaf.  A first parcel that no leaf matches (3,277 of the 65,536) is an illegal instruction.
insn = leaf:( leaf-SYS0-1 | leaf-SYS0-2 | leaf-SYSR-1 | leaf-SYSR-2 | leaf-SETF-1 | leaf-SYSI-1 | leaf-MFSR-1 | leaf-MTSR-1 | leaf-R2-1 | leaf-R3-1
