      | "LDF.PD12"@22 | "LDF.PC32"@23 | "LDF.A32"@24 | "LDFI.I32"@25 | "STF.B28"@26 | "STF.X22"@27 | "STF.PI12"@28 | "STF.PD12"@29 | "STF.PC32"@30
      | "STF.A32"@31 | "CMF.B28"@32 | "CMF.X22"@33 | "CMF.PI12"@34 | "CMF.PD12"@35 | "CMF.PC32"@36 | "CMF.A32"@37 | "CMF.I32"@38 | "SOF.B28"@39
      | "SOF.X22"@40 | "SOF.PI12"@41 | "SOF.PD12"@42 | "SOF.PC32"@43 | "SOF.A32"@44 | "DPF.D28"@45 | "BRF"@46 | "CALLF"@47 | "PUSHMF"@48 | "SOPR"@49
      | "PUSHI3"@50 | "PUSHI2"@51 | "JTAG3"@52 | "JTAG2"@53 | "RRF"@54 | "RRF5"@55 | "CBDI"@56 | "CBDR"@57 | "SOB"@58 | "TAG"@59 | "SPADJF"@60
      | "FX.MOVCALL3"@61 | "FX.MOVCALL2"@62 | "FX.POPMRET"@63 | "FX.POPRET"@64 | "FX.MOV2"@65 | "RR5"@66 | "BR2_16/a"@67 | "CBI4_8H/a"@68
      | "STBu6/a"@69 | "CALL2_16/c"@70 | "CB3I16_12H/b"@71 | "LEASx12H/a"@72 | "LDI12H/b"@73 | "CBR8H/a"@74 | "LDX0/a"@75 | "STBu8H/b"@76
      | "PUSHM16b/a"@77 | "BR2_16/b"@78 | "LDPC12H/a"@79 | "CBR8H/c"@80 | "CB3I16_12H/c"@81 | "LDBu6/b"@82 | "CALL2_18/c"@83 | "CALL2_16/j"@84
