      | "LDBu6/c"@93 | "STBs8H/a"@94 | "SOBu12H/x"@95 | "STX0/b"@96 | "LDBu8H/a"@97 | "LDI16H/a"@98 | "CBI3_8/a"@99 | "CBI8_8H/b"@100
      | "CBI6_8H/a"@101 | "STX0/a"@102 | "LDI12H/c"@103 | "IMMh43/a"@104 | "LDI12/a"@105 | "CBI10_8H/a"@106 | "CB3I8_20H/a"@107 | "BR2_16/c"@108
