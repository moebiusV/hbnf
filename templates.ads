   Zig_Lexer : constant String :=
     "fn lxDigit(c: u8) bool { return c >= '0' and c <= '9'; }" & LF &
     "fn lxWordStart(c: u8) bool {" & LF &
     "    return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z')" & LF &
     "        or c == '_' or c == '-';" & LF &
     "}" & LF &
     "fn lxWordChar(c: u8) bool { return lxWordStart(c) or lxDigit(c) or c == '.'; }" & LF &
     "" & LF &
     "pub fn lex(alloc: std.mem.Allocator, text: []const u8) ![]Token {" & LF &
     "    var toks = std.ArrayList(Token).empty;" & LF &
     "    var i: usize = 0; var line: usize = 1; var col: usize = 1;" & LF &
     "    while (i < text.len) {" & LF &
     "        const c = text[i];" & LF &
     "        {" & LF &
     "            // Hand-written jet scanners (schema `{ }` blocks) win first." & LF &
     "            var jk: Kind = .eof;" & LF &
     "            const jl = jet_dispatch(text, i, text.len, &jk);" & LF &
     "            if (jl > 0) {" & LF &
     "                try toks.append(alloc, .{ .kind = jk, .text = text[i..i + jl], .line = line, .col = col });" & LF &
     "                i += jl; col += jl;" & LF &
     "                continue;" & LF &
     "            }" & LF &
     "        }" & LF &
     "        if (c == ' ' or c == '\t' or c == '\r') { i += 1; col += 1; }" & LF &
     "        else if (c == '\n') { i += 1; line += 1; col = 1; }" & LF &
     "        // backslash-newline continues the line, as parse.y's lgetc()" & LF &
     "        else if (c == '\\' and i + 1 < text.len and text[i + 1] == '\n') { i += 2; line += 1; col = 1; }" & LF &
     "        else if (c == '#') { while (i < text.len and text[i] != '\n') i += 1; }" & LF &
     "        else if (c == '""') {" & LF &
     "            const sc = col;" & LF &
     "            const sl = line;" & LF &
     "            var s = std.ArrayList(u8).empty;" & LF &
     "            i += 1; col += 1;" & LF &
     "            while (i < text.len and text[i] != '""') {" & LF &
     "                // inside quotes parse.y drops backslash-newline and a bare newline" & LF &
     "                if (text[i] == '\\' and i + 1 < text.len and text[i + 1] == '\n') { i += 2; line += 1; col = 1; continue; }" & LF &
     "                if (text[i] == '\n') { i += 1; line += 1; col = 1; continue; }" & LF &
     "                if (text[i] == '\\' and i + 1 < text.len) { i += 1; col += 1; }" & LF &
     "                try s.append(alloc, text[i]);" & LF &
     "                i += 1; col += 1;" & LF &
     "            }" & LF &
     "            if (i < text.len and text[i] == '""') { i += 1; col += 1; }" & LF &
     "            try toks.append(alloc, .{ .kind = .str, .text = try s.toOwnedSlice(alloc), .line = sl, .col = sc });" & LF &
     "        }" & LF &
     "        else if (lxDigit(c) or (c == '-' and i + 1 < text.len and lxDigit(text[i + 1]))) {" & LF &
     "            // -N is a number too, as in parse.y's lexers" & LF &
     "            const s = i; const sc = col;" & LF &
     "            if (c == '-') { i += 1; col += 1; }" & LF &
     "            while (i < text.len and lxDigit(text[i])) { i += 1; col += 1; }" & LF &
     "            if (i < text.len and lxWordChar(text[i])) {" & LF &
     "                // dotted/alphanumeric run (1.2.3.4, 123abc) is one word" & LF &
     "                i = s; col = sc;" & LF &
     "                while (i < text.len and lxWordChar(text[i])) { i += 1; col += 1; }" & LF &
     "                try toks.append(alloc, .{ .kind = .atom, .text = text[s..i], .line = line, .col = sc });" & LF &
     "            } else {" & LF &
     "                try toks.append(alloc, .{ .kind = .int, .text = text[s..i], .line = line, .col = sc });" & LF &
     "            }" & LF &
     "        }" & LF &
     "        else if (lxWordStart(c)) {" & LF &
     "            const s = i; const sc = col;" & LF &
     "            while (i < text.len and lxWordChar(text[i])) { i += 1; col += 1; }" & LF &
     "            try toks.append(alloc, .{ .kind = .atom, .text = text[s..i], .line = line, .col = sc });" & LF &
     "        }" & LF &
     "        else {" & LF &
     "            try toks.append(alloc, .{ .kind = .punct, .text = text[i..i + 1], .line = line, .col = col });" & LF &
     "            i += 1; col += 1;" & LF &
     "        }" & LF &
     "    }" & LF &
     "    try toks.append(alloc, .{ .kind = .eof, .text = """", .line = line, .col = col });" & LF &
     "    return toks.toOwnedSlice(alloc);" & LF &
     "}" & LF &
     "" & LF &
     "pub fn parse_text(alloc: std.mem.Allocator, text: []const u8," & LF &
     "                  err: *[512]u8, err_line: *usize, err_col: *usize) ParseError!@ROOT_TYPE@ {" & LF &
     "    const toks = try lex(alloc, text);" & LF &
     "    var lines = std.ArrayList([]const u8).empty;" & LF &
     "    var s: usize = 0;" & LF &
     "    for (text, 0..) |ch, idx| {" & LF &
     "        if (ch == '\n') {" & LF &
     "            try lines.append(alloc, text[s..idx]);" & LF &
     "            s = idx + 1;" & LF &
     "        }" & LF &
     "    }" & LF &
     "    try lines.append(alloc, text[s..]);" & LF &
     "    return parse_tokens(alloc, toks, lines.items, err, err_line, err_col);" & LF &
     "}";

   Ada_Lexer : constant String :=
     "   function Lex (Text : String) return Token_Vectors.Vector is" & LF &
     "      Toks : Token_Vectors.Vector;" & LF &
     "      I    : Natural := Text'First;" & LF &
     "      Line : Natural := 1;" & LF &
     "      Col  : Natural := 1;" & LF &
     "      C    : Character;" & LF &
     "   begin" & LF &
