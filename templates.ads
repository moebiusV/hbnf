     "}" & LF &
     "" & LF &
     "/* -D name=value: the name ends at the last `=`, as in parse.y. */" & LF &
     "int cmdline_symset(char *s) {" & LF &
     "    const char *val = strrchr(s, '=');" & LF &
     "" & LF &
