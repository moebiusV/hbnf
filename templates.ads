     "        conf_error(0, ""read error"");" & LF &
     "        return -1;" & LF &
     "    }" & LF &
     "    buf[len] = '\0';" & LF &
     "    fclose(f);" & LF &
     "" & LF &
     "    conf_file = filename;" & LF &
     "    conf = (@ROOT_TYPE@ *)calloc(1, sizeof *conf);" & LF &
     "    if (!conf) {" & LF &
