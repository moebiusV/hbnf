     "      return Toks;" & LF &
     "   end Lex;" & LF &
     "" & LF &
     "   function Parse_Text (Text : String) return @ROOT_TYPE@ is" & LF &
     "      Toks  : Token_Vectors.Vector := Lex (Text);" & LF &
     "      Lines : Line_Vectors.Vector;" & LF &
