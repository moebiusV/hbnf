     "    }" & LF &
     "    if (fseek(f, 0, SEEK_END) != 0 || (len = ftell(f)) < 0 ||" & LF &
     "        fseek(f, 0, SEEK_SET) != 0) {" & LF &
     "        fclose(f);" & LF &
     "        conf_error(0, ""cannot read file"");" & LF &
     "        return -1;" & LF &
     "    }" & LF &
     "    buf = (char *)malloc((size_t)len + 1);" & LF &
     "    if (!buf) {" & LF &
