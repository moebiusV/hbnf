     "            end;" & LF &
     "         elsif C in 'a' .. 'z' or else C in 'A' .. 'Z' or else C = '_' or else C = '-' then" & LF &
     "            declare" & LF &
     "               SC  : constant Natural := Col;" & LF &
     "               Buf : Unbounded_String;" & LF &
     "            begin" & LF &
     "               while I <= Text'Last loop" & LF &
     "                  C := Text (I);" & LF &
