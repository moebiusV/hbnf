     "        conf_error(0, ""out of memory"");" & LF &
     "        return -1;" & LF &
     "    }" & LF &
     "    if (len > 0 && fread(buf, 1, (size_t)len, f) != (size_t)len) {" & LF &
     "        free(buf);" & LF &
