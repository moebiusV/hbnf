     "pub var config_error: *const fn(usize, []const u8) void = defaultConfigError;" & LF &
     "" & LF &
     "fn defaultConfigError(line: usize, msg: []const u8) void {" & LF &
     "    if (conf_file) |f| {" & LF &
     "        if (line > 0) {" & LF &
     "            std.debug.print(""{s}:{d}: {s}\n"", .{ f, line, msg });" & LF &
     "        } else {" & LF &
