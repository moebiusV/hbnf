     "                  Buf := Null_Unbounded_String;" & LF &
     "                  while I <= Text'Last loop" & LF &
     "                     C := Text (I);" & LF &
     "                     exit when not (C in 'a' .. 'z' or else C in 'A' .. 'Z'" & LF &
     "                       or else C in '0' .. '9' or else C = '_' or else C = '-'" & LF &
     "                       or else C = '.');" & LF &
     "                     Append (Buf, C); I := I + 1; Col := Col + 1;" & LF &
     "                  end loop;" & LF &
