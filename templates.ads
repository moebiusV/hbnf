     "                i = s; col = sc;" & LF &
     "                while i < b.len() && lx_word_char(b[i]) { i += 1; col += 1; }" & LF &
     "                toks.push(Token { kind: Kind::Atom, text: text[s..i].to_string(), line, col: sc });" & LF &
