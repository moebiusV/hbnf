     "                hbnf_segs[hbnf_nsegs].col0 = col;" & LF &
     "                hbnf_segs[hbnf_nsegs].col1 = col + vl;" & LF &
     "                hbnf_segs[hbnf_nsegs].sym = y;" & LF &
     "                hbnf_nsegs++;" & LF &
     "            }" & LF &
     "            hbnf_put(&o, &used, &cap, y->val, vl);" & LF &
     "            col += vl;" & LF &
     "            i = j;" & LF &
     "            continue;" & LF &
     "        }" & LF &
     "        hbnf_put(&o, &used, &cap, s + i, j - i);" & LF &
     "        for (; i < j; i++) {" & LF &
