/* ---- contexts: named sets of names the parser keeps while it reads ----
   ? ctx asks, %bind adds, %scope ends what was added with its region, and a
   branch or rule that gives up puts every context back (hbnf_mark, hbnf_reset),
   so what a guess bound is gone when the guess is. */
/* One log for every context: an add pushes, so a mark is the log's length and giving up is popping back
   to it.  The usual give-up has nothing to pop, so hbnf_reset is one comparison, inlined; the popping
   is out of line. */
typedef struct {
    const char *s; size_t n; unsigned hash; int prev; unsigned c;
    unsigned char neg;                /* takes the name out (`=> set -= tag`) */
#ifdef HBNF_FACTS
    const char *vs; size_t vn;        /* a fact (`=> tag.attr = tag2`): the value kept under the name, in the context `attr` */
#endif
} hbnf_ce_t;
static struct {
    hbnf_ce_t *e;
    unsigned n, cap;
    int bucket[HBNF_NCTX][256];
} hbnf_cx;
typedef struct { unsigned n; } hbnf_mark_t;

/* The hash of a name: eight bytes at a time, and the last one to seven bytes as overlapping loads of
   the name's own bytes (no read past the name), so a short name is one multiply and not one for each byte. */
static inline unsigned hbnf_chash(const char *s, size_t n) {
    uint64_t h = 0x9E3779B97F4A7C15ull ^ (uint64_t)n, w;
    while (n >= 8) {
        memcpy(&w, s, 8);
        h = (h ^ w) * 0xFF51AFD7ED558CCDull;  h ^= h >> 32;
        s += 8;  n -= 8;
    }
    if (n >= 4) {
        uint32_t a, b;
        memcpy(&a, s, 4);  memcpy(&b, s + n - 4, 4);
        w = ((uint64_t)a << 32) | b;
    } else if (n) {
        w = ((uint64_t)(unsigned char)s[0] << 16) | ((uint64_t)(unsigned char)s[n >> 1] << 8) | (unsigned char)s[n - 1];
    } else w = 0;
    h = (h ^ w) * 0xFF51AFD7ED558CCDull;  h ^= h >> 32;
    h *= 0xC4CEB9FE1A85EC53ull;  h ^= h >> 29;
    return (unsigned)h;
}
static void hbnf_ctx_clear(void) {
    unsigned c;
    int b;
    hbnf_cx.n = 0;
    for (c = 0; c < HBNF_NCTX; c++)
        for (b = 0; b < 256; b++) hbnf_cx.bucket[c][b] = -1;
}
static void hbnf_ctx_put(unsigned c, const char *s, size_t n, unsigned char neg) {
    unsigned h = hbnf_chash(s, n);   /* not remembered from the last ask: the bytes at s may have changed */
    if (hbnf_cx.n == hbnf_cx.cap) {
        hbnf_cx.cap = hbnf_cx.cap ? hbnf_cx.cap * 2 : 64;
        hbnf_cx.e = (hbnf_ce_t *)realloc(hbnf_cx.e, hbnf_cx.cap * sizeof *hbnf_cx.e);
        if (!hbnf_cx.e) hbnf_oom();
    }
    hbnf_cx.e[hbnf_cx.n].s = s;
    hbnf_cx.e[hbnf_cx.n].n = n;
    hbnf_cx.e[hbnf_cx.n].hash = h;
    hbnf_cx.e[hbnf_cx.n].c = c;
    hbnf_cx.e[hbnf_cx.n].neg = neg;
    hbnf_cx.e[hbnf_cx.n].prev = hbnf_cx.bucket[c][h & 255];
    hbnf_cx.bucket[c][h & 255] = (int)hbnf_cx.n++;
}
static inline void hbnf_ctx_add(unsigned c, const char *s, size_t n) { hbnf_ctx_put(c, s, n, 0); }
/* Taking a name out is an entry that says so, newest first, so a mark still undoes it, and adding the name again puts it back. */
static inline void hbnf_ctx_del(unsigned c, const char *s, size_t n) { hbnf_ctx_put(c, s, n, 1); }
#ifdef HBNF_FACTS
/* A fact is an entry of its own context with a value: undone with the match, like an add; the newest entry of a name wins. */
static inline void hbnf_fact_put(unsigned c, const char *s, size_t n, const char *v, size_t vn) {
    hbnf_ctx_put(c, s, n, 0);
    hbnf_cx.e[hbnf_cx.n - 1].vs = v;  hbnf_cx.e[hbnf_cx.n - 1].vn = vn;
}
static int hbnf_fact_get(unsigned c, const char *s, size_t n, const char **v, size_t *vn) {
    unsigned h = hbnf_chash(s, n);
    int i;
    for (i = hbnf_cx.bucket[c][h & 255]; i >= 0; i = hbnf_cx.e[i].prev)
        if (hbnf_cx.e[i].hash == h && hbnf_cx.e[i].n == n && memcmp(hbnf_cx.e[i].s, s, n) == 0) {
            if (hbnf_cx.e[i].neg) return 0;
            *v = hbnf_cx.e[i].vs;  *vn = hbnf_cx.e[i].vn;
            return 1;
        }
    return 0;
}
#endif
static int hbnf_ctx_has(unsigned c, const char *s, size_t n) {
    unsigned h = hbnf_chash(s, n);
    int i;
    for (i = hbnf_cx.bucket[c][h & 255]; i >= 0; i = hbnf_cx.e[i].prev)
        if (hbnf_cx.e[i].hash == h && hbnf_cx.e[i].n == n
            && memcmp(hbnf_cx.e[i].s, s, n) == 0)
            return !hbnf_cx.e[i].neg;
    return 0;
}
static inline hbnf_mark_t hbnf_mark(void) {
    hbnf_mark_t m;
    m.n = hbnf_cx.n;
    return m;
}
static void hbnf_reset_slow(unsigned to) {
    while (hbnf_cx.n > to) {
        hbnf_cx.n--;
        hbnf_cx.bucket[hbnf_cx.e[hbnf_cx.n].c][hbnf_cx.e[hbnf_cx.n].hash & 255]
            = hbnf_cx.e[hbnf_cx.n].prev;
    }
}
static inline void hbnf_reset(const hbnf_mark_t *m) {
    if (hbnf_cx.n > m->n) hbnf_reset_slow(m->n);
}
/* For %where { } and %bind { }: HBNF_IN (types, text, len) asks, HBNF_ADD adds. */
#define HBNF_IN(c, s, n) hbnf_ctx_has(CTX_##c, (s), (n))
#define HBNF_ADD(c, s, n) hbnf_ctx_add(CTX_##c, (s), (n))
