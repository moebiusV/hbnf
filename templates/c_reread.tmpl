        else { (txt) = "";  (tn) = 0; }                                                                                     \
    } while (0)
    hbnf_sb_add(&out, " ", 1);
    for (i = 0; i < bn; ) {
        unsigned char c = (unsigned char)body[i];
        if (c == '"' || c == '\'') {                          /* a string or character constant is copied as it stands */
            size_t j = i + 1;
            while (j < bn && body[j] != (char)c) { if (body[j] == '\\' && j + 1 < bn) j++; j++; }
            if (j < bn) j++;
            if (paste_next == 1) hbnf_paste_check(&out, body + i, j - i, base + st);
            hbnf_sb_add(&out, body + i, j - i);  i = j;  paste_next = 0;  lhs_empty = 0;
        } else if (c == '/' && i + 1 < bn && body[i + 1] == '*') {         /* a comment in a body is one blank */
            size_t j = i + 2;
            while (j + 1 < bn && !(body[j] == '*' && body[j + 1] == '/')) j++;
            j = j + 2 <= bn ? j + 2 : bn;
            hbnf_sb_add(&out, " ", 1);  i = j;
        } else if (c == '/' && i + 1 < bn && body[i + 1] == '/') {
            while (i < bn && body[i] != '\n') i++;
            hbnf_sb_add(&out, " ", 1);
        } else if ((c >= '0' && c <= '9') || (c == '.' && i + 1 < bn && body[i + 1] >= '0' && body[i + 1] <= '9')) {   /* a number: one token */
            size_t j = i + 1;
            while (j < bn && (hbnf_id((unsigned char)body[j]) || body[j] == '.'
                              || ((body[j] == '+' || body[j] == '-') && (body[j - 1] == 'e' || body[j - 1] == 'E' || body[j - 1] == 'p' || body[j - 1] == 'P')))) j++;
            if (paste_next == 1) hbnf_paste_check(&out, body + i, j - i, base + st);
            hbnf_sb_add(&out, body + i, j - i);  i = j;  paste_next = 0;  lhs_empty = 0;
        } else if (hbnf_hash2(body + i, bn - i)) {     /* ## (or its digraph %:%:) */
            size_t j = i + hbnf_hash2(body + i, bn - i), e;
            int lhs_was_empty = lhs_empty;
            /* the blank before `##` goes, unless the left side was nothing: the token before it is then not the one pasted */
            while (!lhs_empty && out.n > 1 && hbnf_ws((unsigned char)out.s[out.n - 1])) out.n--;     /* (the blank that begins out stays) */
            lhs_empty = 0;
            if (out.s) out.s[out.n] = 0;
            while (j < bn && hbnf_ws((unsigned char)body[j])) j++;
            /* `, ## __VA_ARGS__` with nothing for the `...`: the comma goes too */
            e = j;
            while (e < bn && hbnf_id((unsigned char)body[e])) e++;
            if (variadic && out.n > 0 && out.s[out.n - 1] == ',' && e - j == vlen && memcmp(body + j, vname, vlen) == 0) {
                /* gcc: the comma goes when the `...` has no argument, and keeps when it has an empty one (`f(x, )`); a macro that is only
                   `...` called with `()` has none */
                int none = na <= npf || (npf == 0 && na == 1 && ra[0].n == 0);
                if (none) { out.n--;  out.s[out.n] = 0;  i = e;  continue; }
            }
            i = j;  paste_next = lhs_was_empty ? 2 : 1;
        } else if (hbnf_hash1(body + i, bn - i)) {              /* # param (or its digraph %:) */
            size_t j = i + hbnf_hash1(body + i, bn - i), e;
            while (j < bn && hbnf_ws((unsigned char)body[j])) j++;
            e = j;
            while (e < bn && hbnf_id((unsigned char)body[e])) e++;
            for (k = 0; e > j && k < np; k++) {
                size_t len = (variadic && k == np - 1) ? vlen : pl[k].n;
                const char *nm = (variadic && k == np - 1) ? vname : pl[k].s;
                if (len == e - j && memcmp(nm, body + j, len) == 0) break;
            }
            if (e > j && k < np) {
                const char *t; size_t tn;
                HB_ARG(ra, na, k, t, tn);
                hbnf_stringify(&out, t, tn);  i = e;  paste_next = 0;
            } else { hbnf_sb_add(&out, body + i, hbnf_hash1(body + i, bn - i));  i += hbnf_hash1(body + i, bn - i); }
        } else if (hbnf_id0(c)) {
            size_t j = i, e;
            int hit = -1, join, was_paste = 0;
            while (j < bn && hbnf_id((unsigned char)body[j])) j++;
            for (k = 0; k < np; k++) {
                size_t len = (variadic && k == np - 1) ? vlen : pl[k].n;
                const char *nm = (variadic && k == np - 1) ? vname : pl[k].s;
                if (len == j - i && memcmp(nm, body + i, len) == 0) { hit = k; break; }
            }
            if (hit >= 0) {
                const char *t; size_t tn;
                e = j;
                while (e < bn && hbnf_ws((unsigned char)body[e])) e++;
                was_paste = paste_next;
                join = paste_next || (e < bn && hbnf_hash2(body + e, bn - e));
                if (join) HB_ARG(ra, na, hit, t, tn); else HB_ARG(xa, nx, hit, t, tn);
                /* (`, ## args`, with args the `...` of the macro, is gcc's way to have a comma that goes when there is nothing after it: no paste, so no check) */
                if (paste_next == 1 && tn > 0 && !(variadic && hit == npf)) hbnf_paste_check(&out, t, tn, base + st);
                hbnf_putarg(&out, t, tn, join, base);
                /* an empty left operand leaves the blank before it standing; an empty one that is itself the right side of a `##` is joined to what is before it */
                lhs_empty = (tn == 0 && !was_paste && e < bn && hbnf_hash2(body + e, bn - e));
            } else { if (paste_next == 1) hbnf_paste_check(&out, body + i, j - i, base + st);  hbnf_sb_add(&out, body + i, j - i);  lhs_empty = 0; }
            i = j;  paste_next = 0;
        } else if (hbnf_ws(c)) { hbnf_sb_add(&out, body + i, 1);  i++; }
        else {                                                               /* a punctuator (or any other character): one token */
            size_t tl = hbnf_tok_len(body + i, bn - i);
            if (tl == 0) tl = 1;
            if (paste_next == 1) hbnf_paste_check(&out, body + i, tl, base + st);
            hbnf_sb_add(&out, body + i, tl);  i += tl;  paste_next = 0;  lhs_empty = 0;
        }
    }
#undef HB_ARG
    free(vopt_buf);
    if (xa != ra) free(xa);
    free(ra);  free(pl);
    /* The expansion is a run of tokens of its own: where its first or last character would make one token with the character beside it (`-M` with M
       `-`, `ID(a)ID(b)`, `L` before a string), a blank is put between, and nowhere else (so `vers2` before `.h` stays two tokens of a stringified text). */
    {
        size_t first = 1, last = out.n;
        size_t q;
        int lead, trail;
        while (first < out.n && hbnf_ws((unsigned char)out.s[first])) first++;
        while (last > first && hbnf_ws((unsigned char)out.s[last - 1])) last--;
        lead  = first < out.n ? (st > 0 && hbnf_glue_at(base, st - 1, (unsigned char)out.s[first]))
                              : (st > 0 && base[en] != 0 && hbnf_glue_at(base, st - 1, (unsigned char)base[en]));   /* an expansion of nothing keeps the tokens beside it apart */
        trail = last > first && base[en] != 0 && hbnf_glue_at(out.s, last - 1, (unsigned char)base[en]);
        if (!lead) {                                      /* the blank put in before the loop is not needed: out moves left, and the places recorded with it */
            memmove(out.s, out.s + 1, out.n);  out.n--;
            for (q = 0; q < hbnf_ncp_new; q++) hbnf_cp_new[q].os--;
        }
        if (trail) hbnf_sb_add(&out, " ", 1);
    }
    free(b->s);  *b = out;
    if (!b->s) { b->s = (char *)malloc(1);  if (!b->s) hbnf_oom();  b->s[0] = 0; }
}
