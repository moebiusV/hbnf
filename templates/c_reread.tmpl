/* ---- rewrites: `=> template` replaces the text a match stands for (CONTEXTS.md section 30) ----
   The template is built in a buffer (hbnf_sb); hbnf_reread notes where the match was and what replaces it.
   `=>` goes on reading: the outermost rule that began where the replaced text began (hbnf_rr_mine) splices the new text in
   (hbnf_rr_apply: in place, the text before it does not move) and reads it again from its first alternative, with the contexts and
   facts as they are; the strings of the tree are slices of the text, which is kept until the next parse_text.
   `=>>` rewinds: parse_text splices the new text in and starts the parse over on it, so what was read before the match is
   read again, a definition that made a fact makes it again, and a use that was replaced is no longer there to match; the tree
   of a parse that is started over is dropped.  It is the work `=>` does not do, and no grammar of the standards needs it. */
typedef struct { char *s; size_t n, cap; } hbnf_sb;
static void hbnf_sb_add(hbnf_sb *b, const char *s, size_t n) {
    if (b->n + n + 1 > b->cap) {
        b->cap = (b->n + n + 1) * 2;
        b->s = (char *)realloc(b->s, b->cap);
        if (!b->s) hbnf_oom();
    }
    memcpy(b->s + b->n, s, n);  b->n += n;  b->s[b->n] = 0;
}
static void hbnf_sb_adds(hbnf_sb *b, const char *s) { hbnf_sb_add(b, s, strlen(s)); }
static void hbnf_cp_add(size_t ss, size_t os, size_t n);
/* the text of a tag, put in a template: the place it was is noted */
static void hbnf_sb_tag(hbnf_sb *b, const char *text, const char *s, size_t n) {
    if (s >= text && n) hbnf_cp_add((size_t)(s - text), b->n, n);
    hbnf_sb_add(b, s, n);
}
#ifndef HBNF_MAX_REREAD
#define HBNF_MAX_REREAD 0           /* rewrites in one parse; 0: no limit (-DHBNF_MAX_REREAD=n stops a rewrite that never ends at n) */
#endif
static int hbnf_rr;                           /* a rewrite is waiting to be made */
static int hbnf_rr_cont;                      /* ... and it goes on reading where the text it replaces began (`=>`); 0: the parse starts over (`=>>`) */
static size_t hbnf_rr_len0;                   /* the length of the text before it, which the parser was made to see as cut short */
static unsigned hbnf_rd;                      /* the rules being read, and where each began: a continuing rewrite is made by the outermost one */
static size_t hbnf_rs[4096 + 8];
static size_t hbnf_rr_s, hbnf_rr_e;           /* the text it replaces: [s, e) */
static char *hbnf_rr_t;  static size_t hbnf_rr_tn;   /* and what it replaces it with */
static unsigned hbnf_rr_n;                    /* rewrites made in this parse */
static unsigned hbnf_rr_count(void) { return hbnf_rr_n; }
static int hbnf_rr_pending(void) { return hbnf_rr; }   /* a rewrite is waiting: the alternatives that are tried after the one that asked for it are not heard */
#ifndef HBNF_MAX_REWORK
#define HBNF_MAX_REWORK 0           /* bytes a parse reads again (`=>>`) or moves (`=>`) because of rewrites; 0: no limit (-DHBNF_MAX_REWORK=n) */
#endif
static size_t hbnf_rr_work;
static char *hbnf_rr_buf;                     /* the text of the last rewrite */
/* The chain of rewrites, so that an error is reported against the text the user wrote (CONTEXTS.md section 30, R591): each
   splice is logged with where its text stands in the text it made, where the text it replaced stood in the text before, and
   the rule whose `=>` made it.  hbnf_rr_orig is the text before the first rewrite. */
typedef struct { size_t ns, nlen, os, oe; const char *rule; const char *file, *src; const size_t *map; size_t nmap; int macro; } hbnf_rr_rec;   /* map: where text was taken out (pairs: place in the new text, how much) */   /* file, src: the text is that of an included file */
static hbnf_rr_rec *hbnf_rr_log;  static size_t hbnf_rr_nlog, hbnf_rr_caplog;
static const char *hbnf_rr_orig;
static const char *hbnf_rr_rule_;            /* the rule that asked for the rewrite waiting to be made */
/* where hbnf_subst copied an argument's text from: a place inside that text (a name that is hidden there) goes with the copy, as gcc
   keeps a name it has painted unexpandable wherever the token goes.  A run is [ss, ss + n) of the text being read, now at os in the text made. */
typedef struct { size_t ss, os, n; } hbnf_cpy;
static hbnf_cpy *hbnf_cp_new, *hbnf_cp_now;  static size_t hbnf_ncp_new, hbnf_capcp_new, hbnf_ncp_now;
/* A template copies text of the text being read (a tag) or has a native function make some (a function of a tag): where each piece came from is noted, so that a
   name that is hidden in it is hidden where it goes (hbnf_cp_add, below).  hbnf_tpl_base is where in the template the result of the function being called
   begins, and hbnf_tpl_text the text being read, for the function to note what it took from it (hbnf_cp_note). */
static size_t hbnf_tpl_base;  static const char *hbnf_tpl_text;
static void hbnf_cp_add(size_t ss, size_t os, size_t n);
static void hbnf_cp_note(const char *src, size_t n, size_t out_in_result) {
    if (hbnf_tpl_text && src >= hbnf_tpl_text) hbnf_cp_add((size_t)(src - hbnf_tpl_text), hbnf_tpl_base + out_in_result, n);
}
static void (*hbnf_arity_hook)(const char *at, const char *name, size_t nl, int np, int na, int variadic);   /* told of a call whose number of arguments is not the macro's */
static void hbnf_cp_add(size_t ss, size_t os, size_t n) {
    if (hbnf_ncp_new > 0 && hbnf_cp_new[hbnf_ncp_new - 1].ss + hbnf_cp_new[hbnf_ncp_new - 1].n == ss
        && hbnf_cp_new[hbnf_ncp_new - 1].os + hbnf_cp_new[hbnf_ncp_new - 1].n == os) { hbnf_cp_new[hbnf_ncp_new - 1].n += n;  return; }
    if (hbnf_ncp_new == hbnf_capcp_new) {
        hbnf_capcp_new = hbnf_capcp_new ? hbnf_capcp_new * 2 : 16;
        hbnf_cp_new = (hbnf_cpy *)realloc(hbnf_cp_new, hbnf_capcp_new * sizeof *hbnf_cp_new);
        if (!hbnf_cp_new) hbnf_oom();
    }
    hbnf_cp_new[hbnf_ncp_new].ss = ss;  hbnf_cp_new[hbnf_ncp_new].os = os;  hbnf_cp_new[hbnf_ncp_new].n = n;  hbnf_ncp_new++;
}
/* Text that is a file's (an `#include`): native code building a template says so with hbnf_text_from (file name and contents; hbnf_src_keep
   hands it a string to keep until the next parse), and the rewrite that is made records it, so that a place in that text is known by the
   file and the line in it (`__LINE__`, `__FILE__`). */
static const char *hbnf_cur_file, *hbnf_cur_src, *hbnf_rr_file, *hbnf_rr_src;
static char **hbnf_srcs;  static size_t hbnf_nsrcs, hbnf_capsrcs;
static size_t hbnf_nlines;                    /* the `#line` places (below), cleared with the rest */
static char *hbnf_src_keep(char *p) {
    if (hbnf_nsrcs == hbnf_capsrcs) {
        hbnf_capsrcs = hbnf_capsrcs ? hbnf_capsrcs * 2 : 16;
        hbnf_srcs = (char **)realloc(hbnf_srcs, hbnf_capsrcs * sizeof *hbnf_srcs);
        if (!hbnf_srcs) hbnf_oom();
    }
    hbnf_srcs[hbnf_nsrcs++] = p;
    return p;
}
static void hbnf_text_from(const char *file, const char *src) { hbnf_cur_file = file;  hbnf_cur_src = src; }
/* a rewrite that takes text out here and there (`\`-newline, a trigraph made one character): native code gives the places, as pairs (place in the new
   text, how much was taken out there), so that a place after them is known by where it was in the text before */
static char *hbnf_rr_hn;                      /* the name the rewrite waiting to be made hides (below) */
static int hbnf_rr_macro;                    /* the rewrite that is waiting hides a name (`hiding`): its text is a macro's expansion */
static const size_t *hbnf_cur_map, *hbnf_rr_map;  static size_t hbnf_cur_nmap, hbnf_rr_nmap;
static void hbnf_map_from(const size_t *map, size_t n) { hbnf_cur_map = map;  hbnf_cur_nmap = n; }
static void hbnf_reread(size_t s, size_t e, hbnf_sb *b, const char *rule, int cont) {
    /* a rewrite is waiting already: the rest of the rules, reading the text as cut short, try again and come to the same place; the first
       request is the one that counts */
    if (hbnf_rr) { free(b->s);  hbnf_ncp_new = 0;  hbnf_cur_file = hbnf_cur_src = NULL;  hbnf_cur_map = NULL;  hbnf_cur_nmap = 0;  return; }
    /* the copies hbnf_subst made go with the rewrite that is made */
    free(hbnf_cp_now);  hbnf_cp_now = hbnf_cp_new;  hbnf_ncp_now = hbnf_ncp_new;  hbnf_cp_new = NULL;  hbnf_ncp_new = 0;  hbnf_capcp_new = 0;
    hbnf_rr_file = hbnf_cur_file;  hbnf_rr_src = hbnf_cur_src;  hbnf_cur_file = hbnf_cur_src = NULL;
    hbnf_rr_macro = hbnf_rr_hn != NULL;
    hbnf_rr_map = hbnf_cur_map;  hbnf_rr_nmap = hbnf_cur_nmap;  hbnf_cur_map = NULL;  hbnf_cur_nmap = 0;
    hbnf_rr = 1;  hbnf_rr_cont = cont;  hbnf_rr_s = s;  hbnf_rr_e = e;  hbnf_rr_rule_ = rule;
    free(hbnf_rr_t);
    hbnf_rr_t = b->s ? b->s : strdup("");
    hbnf_rr_tn = b->n;
}
/* `->`: how many templates are being read inside one another (the quiet bodies of the rules do not count the depth of
   a read): a `->` whose template comes back to the rule that rewrites it stops here. */
#ifndef HBNF_MAX_TREE_DEPTH
#define HBNF_MAX_TREE_DEPTH 200
#endif
static unsigned hbnf_td;
/* `=> ... hiding N`: where a rewrite made text, the name N is not read again by `x not in hidden` (a macro is not expanded in its own
   expansion, which would never end).  A place is a range of the text, and moves with it as later rewrites change the text before it. */
typedef struct { size_t s, e; char *name; size_t nlen; } hbnf_hide_t;
static hbnf_hide_t *hbnf_hide;  static size_t hbnf_nhide, hbnf_caphide;
static char *hbnf_rr_hn;  static size_t hbnf_rr_hnl;     /* the name the rewrite waiting to be made hides, copied */
static void hbnf_rr_hide(const char *s, size_t n) {
    free(hbnf_rr_hn);  hbnf_rr_hn = (char *)malloc(n + 1);
    if (!hbnf_rr_hn) hbnf_oom();
    memcpy(hbnf_rr_hn, s, n);  hbnf_rr_hn[n] = 0;  hbnf_rr_hnl = n;
}
static int hbnf_hidden(const parser_t *p, size_t pos, size_t len) {
    size_t i;
    for (i = 0; i < hbnf_nhide; i++)
        if (hbnf_hide[i].s <= pos && pos < hbnf_hide[i].e && hbnf_hide[i].nlen == len && memcmp(p->text + pos, hbnf_hide[i].name, len) == 0) return 1;
    return 0;
}
/* a rewrite replaced [s, e) by tn bytes: the places move with the text, a place the replaced text is inside grows or shrinks with it, and
   a place that was in the replaced text, or that the parse has gone past (when it goes on: it does not come back), is dropped */
static void hbnf_hide_move(const char *text, size_t s, size_t e, size_t tn, int cont) {
    size_t i, k = 0, nadd = 0, capadd = 0, keep = 0;
    int keep_known = 0;
    hbnf_hide_t *add = NULL;
    for (i = 0; i < hbnf_nhide; i++) {
        hbnf_hide_t h = hbnf_hide[i];
        if (h.s >= e) { h.s = h.s - (e - s) + tn;  h.e = h.e - (e - s) + tn; }
        else if (h.s <= s && e <= h.e) h.e = h.e - (e - s) + tn;
        else if (h.e <= s) {
            /* before the rewrite, and a continuing parse does not come back to it: dropped, unless an argument that is still being read
               may yet be copied into a body (a macro call is \001 NAME \002 ... \004 until it is replaced), and the names painted
               in it go with the copy; the places are kept until there are so many that they are worth sorting out */
            if (cont && hbnf_nhide > 256) {
                if (!keep_known) {
                    size_t q;  int depth = 0;
                    keep = s;  keep_known = 1;
                    for (q = 0; q < s; q++) {
                        if (text[q] == '\001') { if (depth++ == 0) keep = q; }
                        else if (text[q] == '\004' && depth > 0 && --depth == 0) keep = s;
                    }
                }
                if (h.e <= keep) { free(h.name); continue; }
            }
        }
        else {
            /* inside the text that is replaced: where it was copied to, it is a place of its own */
            size_t c;
            for (c = 0; c < hbnf_ncp_now; c++) {
                size_t lo = h.s > hbnf_cp_now[c].ss ? h.s : hbnf_cp_now[c].ss;
                size_t hi = h.e < hbnf_cp_now[c].ss + hbnf_cp_now[c].n ? h.e : hbnf_cp_now[c].ss + hbnf_cp_now[c].n;
                if (lo < hi) {
                    if (nadd == capadd) { capadd = capadd ? capadd * 2 : 8; add = (hbnf_hide_t *)realloc(add, capadd * sizeof *add); if (!add) hbnf_oom(); }
                    add[nadd].s = s + hbnf_cp_now[c].os + (lo - hbnf_cp_now[c].ss);  add[nadd].e = add[nadd].s + (hi - lo);
                    add[nadd].name = (char *)malloc(h.nlen + 1);  if (!add[nadd].name) hbnf_oom();
                    memcpy(add[nadd].name, h.name, h.nlen);  add[nadd].name[h.nlen] = 0;  add[nadd].nlen = h.nlen;  nadd++;
                }
            }
            free(h.name);  continue;
        }
        hbnf_hide[k++] = h;
    }
    hbnf_nhide = k;
    for (i = 0; i < nadd; i++) {
        if (hbnf_nhide == hbnf_caphide) {
            hbnf_caphide = hbnf_caphide ? hbnf_caphide * 2 : 16;
            hbnf_hide = (hbnf_hide_t *)realloc(hbnf_hide, hbnf_caphide * sizeof *hbnf_hide);
            if (!hbnf_hide) hbnf_oom();
        }
        hbnf_hide[hbnf_nhide++] = add[i];
    }
    free(add);
    if (hbnf_rr_hn) {
        if (hbnf_nhide == hbnf_caphide) {
            hbnf_caphide = hbnf_caphide ? hbnf_caphide * 2 : 16;
            hbnf_hide = (hbnf_hide_t *)realloc(hbnf_hide, hbnf_caphide * sizeof *hbnf_hide);
            if (!hbnf_hide) hbnf_oom();
        }
        hbnf_hide[hbnf_nhide].s = s;  hbnf_hide[hbnf_nhide].e = s + tn;
        hbnf_hide[hbnf_nhide].name = hbnf_rr_hn;  hbnf_hide[hbnf_nhide].nlen = hbnf_rr_hnl;  hbnf_nhide++;
        hbnf_rr_hn = NULL;
    }
}
/* the texts a continuing rewrite left behind: what was read from them (the strings of the tree) stays valid until the next parse */
static char **hbnf_keep;  static size_t hbnf_nkeep, hbnf_capkeep;
static void hbnf_reread_clear(void) {
    size_t i;
    hbnf_ncp_new = 0;  hbnf_ncp_now = 0;
    for (i = 0; i < hbnf_nsrcs; i++) free(hbnf_srcs[i]);
    hbnf_nlines = 0;  hbnf_nsrcs = 0;  hbnf_cur_map = hbnf_rr_map = NULL;  hbnf_cur_nmap = hbnf_rr_nmap = 0;  hbnf_cur_file = hbnf_cur_src = hbnf_rr_file = hbnf_rr_src = NULL;
    for (i = 0; i < hbnf_nkeep; i++) free(hbnf_keep[i]);
    hbnf_nkeep = 0;
    for (i = 0; i < hbnf_nhide; i++) free(hbnf_hide[i].name);
    hbnf_nhide = 0;  free(hbnf_rr_hn);  hbnf_rr_hn = NULL;
    hbnf_rr = 0;  hbnf_rr_cont = 0;  hbnf_rd = 0;  hbnf_rr_n = 0;  hbnf_rr_work = 0;  hbnf_rr_buf = NULL;  hbnf_td = 0;  hbnf_rr_nlog = 0;  hbnf_rr_orig = NULL;
}
/* Where position pos of the text being read stood in the text the user wrote; rules[0 .. *nr) are the rules whose
   expansions held it, the newest first.  The log is walked back, newest first: a position after a splice moves by what
   the splice changed, one inside the text a splice made goes to the start of the text it replaced. */
static size_t hbnf_origin(size_t pos, const char *rules[4], int *nr, const char **after) {
    size_t i = hbnf_rr_nlog;
    *nr = 0;  *after = NULL;
    while (i > 0) {
        const hbnf_rr_rec *r = &hbnf_rr_log[--i];
        if (pos == r->ns + r->nlen && r->nlen > 0 && !*after && !*nr) *after = r->rule;   /* just after the text a rewrite made */
        if (pos >= r->ns + r->nlen) pos = pos - r->nlen + (r->oe - r->os);
        else if (pos >= r->ns) { pos = r->os;  if (*nr < 4) rules[(*nr)++] = r->rule; }
    }
    return pos;
}
/* The file and line, in the text the user wrote, of the place s of the text being read (`__LINE__`, `__FILE__`: that of the macro call a place
   came from, and for the text of an included file the line in it).  The text parse_text was given is hbnf_text0; the text being read is the one
   the last rewrite made, or that one before any.  *file is NULL for the text parse_text was given. */
static const char *hbnf_text0;
/* `#line N "file"` (native code says it with hbnf_line_add): from place ps of the text the user wrote, the lines are numbered from no, and the file
   is called file */
typedef struct { size_t ps, no; const char *file; } hbnf_line_rec;
static hbnf_line_rec *hbnf_lines;  static size_t hbnf_nlines, hbnf_caplines;
static void hbnf_line_add(size_t ps, size_t no, const char *file) {
    if (hbnf_nlines == hbnf_caplines) {
        hbnf_caplines = hbnf_caplines ? hbnf_caplines * 2 : 8;
        hbnf_lines = (hbnf_line_rec *)realloc(hbnf_lines, hbnf_caplines * sizeof *hbnf_lines);
        if (!hbnf_lines) hbnf_oom();
    }
    hbnf_lines[hbnf_nlines].ps = ps;  hbnf_lines[hbnf_nlines].no = no;  hbnf_lines[hbnf_nlines].file = file;  hbnf_nlines++;
}
/* where the place s of the text being read stands in the text the user wrote; *inc is the file and *line the line in it when it is in the text of an
   included file (then the result is not an offset) */
static size_t hbnf_walk(const char *s, const char **inc, size_t *line, size_t *incoff, int *made) {
    const char *base = hbnf_rr_n ? hbnf_rr_buf : hbnf_text0;
    size_t pos, i = hbnf_rr_nlog, j;
    *inc = NULL;  *line = 1;  *incoff = 0;  *made = 0;
    if (!base || !hbnf_text0 || s < base) return 0;
    pos = (size_t)(s - base);
    while (i > 0) {
        const hbnf_rr_rec *r = &hbnf_rr_log[--i];
        if (pos >= r->ns + r->nlen) pos = pos - r->nlen + (r->oe - r->os);
        else if (pos >= r->ns) {
            if (r->file) {                                  /* inside the text of an included file */
                size_t k = pos - r->ns, extra = 0, q;
                if (r->map) for (q = 0; q < r->nmap; q++) if (r->map[2 * q] <= k) extra += r->map[2 * q + 1];   /* splices taken out of it: back to the file as it is */
                k += extra;
                for (j = 0; j < k && r->src[j]; j++) if (r->src[j] == '\n') (*line)++;
                *inc = r->file;  *incoff = k;
                return pos;
            }
            if (r->map) {                                   /* text was taken out of it here and there: a place is where it was, plus that */
                size_t k = pos - r->ns, extra = 0, q;
                for (q = 0; q < r->nmap; q++) if (r->map[2 * q] <= k) extra += r->map[2 * q + 1];
                pos = r->os + k + extra;
                continue;
            }
            if (!*made) *made = r->macro ? 2 : 1;           /* the first (newest) rewrite whose text the place is in */
            pos = r->os;
        }
    }
    return pos;
}
/* how many included files the place s of the text being read is in (`__INCLUDE_LEVEL__`) */
static size_t hbnf_inc_depth(const char *s) {
    const char *base = hbnf_rr_n ? hbnf_rr_buf : hbnf_text0;
    size_t pos, i = hbnf_rr_nlog, depth = 0;
    if (!base || !hbnf_text0 || s < base) return 0;
    pos = (size_t)(s - base);
    while (i > 0) {
        const hbnf_rr_rec *r = &hbnf_rr_log[--i];
        if (pos >= r->ns + r->nlen) pos = pos - r->nlen + (r->oe - r->os);
        else if (pos >= r->ns) {
            if (r->file) depth++;
            if (r->map) {
                size_t k = pos - r->ns, extra = 0, q;
                for (q = 0; q < r->nmap; q++) if (r->map[2 * q] <= k) extra += r->map[2 * q + 1];
                pos = r->os + k + extra;
            } else pos = r->os;
        }
    }
    return depth;
}
static size_t hbnf_orig_offset(const char *s) { const char *f; size_t l, o; int m; return hbnf_walk(s, &f, &l, &o, &m); }
/* whether the place s of the text being read is the start of a line (the built-in `bol`, when a grammar rewrites its text).  A place is judged by where
   it stood in the text the user wrote (or in the included file it came from): after `EMPTY`, a `#` is still where it was.  What a macro made (a
   name that `hiding` hid) is no start of a line, and what another rewrite put back is judged by the text as it is now. */
static int hbnf_orig_bol(const char *s) {
    const char *f, *src = NULL, *base = hbnf_rr_n ? hbnf_rr_buf : hbnf_text0;
    size_t line, off, pos, i = hbnf_rr_nlog;
    int made;
    pos = hbnf_walk(s, &f, &line, &off, &made);
    if (made == 2) return 0;
    if (made == 1 || !hbnf_text0) return s == base || s[-1] == '\n' || s[-1] == '\r';
    if (f) {
        while (i > 0) { const hbnf_rr_rec *r = &hbnf_rr_log[--i]; if (r->file == f) { src = r->src;  break; } }
        return !src || off == 0 || src[off - 1] == '\n' || src[off - 1] == '\r';
    }
    return pos == 0 || hbnf_text0[pos - 1] == '\n' || hbnf_text0[pos - 1] == '\r';
}
static size_t hbnf_orig_place(const char *s, const char **file) {
    size_t pos, line, i, from = 0, no = 1, best = 0;
    int have = 0;
