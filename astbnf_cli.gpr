--  The astbnf command-line tool: reads a schema, emits a self-contained
--  parser (declarations + lexer + parser) in the chosen backend language.
--  Links against the static libastbnf.a.

with "astbnf.gpr";

project ASTBNF_Cli is

   for Languages use ("Ada");
   for Source_Dirs use (".");
   for Source_Files use ("astbnf_cli.adb");
   for Main use ("astbnf_cli.adb");
   for Object_Dir use "obj-cli";
   for Create_Missing_Dirs use "True";
   for Exec_Dir use ".";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatVa", "-gnato",
         "-gnaty3abcefhiklmnprt");
   end Compiler;

end ASTBNF_Cli;
